<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<Window
    x:Class="NCWE.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NCWE.Studio"
    Title="NCWE Studio — Night City World Editor">

    <Grid x:Name="Root" Background="{StaticResource ShellBackgroundBrush}" AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ===== Title bar with menus ===== -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="{StaticResource ShellBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/ncwe-logo.png" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="10,0,6,0" AutomationProperties.Name="NCWE" />
            <MenuBar x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center" Height="30">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="Home screen" Click="OnShowHome"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="New world project" Click="OnNewProject"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open project…" Click="OnOpenProject">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="RecentMenu" Text="Open recent">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="Save project" Click="OnSaveProject">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save project as…" Click="OnSaveProjectAs"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Save to the cloud" Click="OnSaveToCloud" ToolTipService.ToolTip="Saves this world (with the custom meshes and sounds it uses) to your Open//77 cloud, as a new version">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE753;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Shift" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open from the cloud…" Click="OnOpenFromCloud"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Export ArchiveXL mod…" Click="OnExport"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Export for Open77 (required mod)…" Click="OnExportOpen77"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Export for World Builder…" Click="OnExportWorldBuilder"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Install last export (game closed)" Click="OnInstall"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Remove an installed NCWE mod…" Click="OnRemoveMod"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xECC9;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Recover autosave…" Click="OnRecover"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Choose game installation…" Click="OnBrowseGame"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7FC;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnExit"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem x:Name="UndoMenu" Text="Undo" Click="OnUndo">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Z" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="RedoMenu" Text="Redo" Click="OnRedo">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Y" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Duplicate" Click="OnDuplicate">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="D" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete" Click="OnDelete"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Reset transform" Click="OnResetTransform"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="New folder from selection" Click="OnNewFolder">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="G" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Rename in the outliner" Click="OnRenameSelection" KeyboardAcceleratorTextOverride="F2">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Drop to ground" Click="OnDropToGround"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Copy" Click="OnCopy" KeyboardAcceleratorTextOverride="Ctrl+C"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Paste in place" Click="OnPaste" KeyboardAcceleratorTextOverride="Ctrl+V"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Paste under the cursor" Click="OnPasteHere" KeyboardAcceleratorTextOverride="Ctrl+Shift+V"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B0;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save selection as prefab…" Click="OnSavePrefab"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Hide selection" Click="OnHideSelection" KeyboardAcceleratorTextOverride="H"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Isolate selection (on / off)" Click="OnIsolateSelection" KeyboardAcceleratorTextOverride="Shift+H"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Show everything" Click="OnRevealAll" KeyboardAcceleratorTextOverride="Alt+H"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE890;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Lock / unlock selection" Click="OnLockSelection" KeyboardAcceleratorTextOverride="L"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Unlock everything" Click="OnUnlockAll" KeyboardAcceleratorTextOverride="Alt+L"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE785;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Arrange">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A9;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="Align X: left edges" Tag="0:Min" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align X: centres" Tag="0:Center" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align X: right edges" Tag="0:Max" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align Y: south edges" Tag="1:Min" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align Y: centres" Tag="1:Center" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align Y: north edges" Tag="1:Max" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align Z: bottoms" Tag="2:Min" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align Z: centres" Tag="2:Center" Click="OnAlignMenu" />
                        <MenuFlyoutItem Text="Align Z: tops" Tag="2:Max" Click="OnAlignMenu" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Distribute along X" Tag="0" Click="OnDistributeMenu" />
                        <MenuFlyoutItem Text="Distribute along Y" Tag="1" Click="OnDistributeMenu" />
                        <MenuFlyoutItem Text="Distribute along Z" Tag="2" Click="OnDistributeMenu" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Duplicate in series… (Inspector ▸ Arrange)" Click="OnShowArrange" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="Deselect" Click="OnDeselect"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E6;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- How placing and transforming behave (MainWindow.Preferences). -->
                    <MenuFlyoutSubItem Text="Preferences">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutSubItem.Icon>
                        <ToggleMenuFlyoutItem x:Name="AlignPlacedMenu" Text="Line up placed objects with their neighbour" IsChecked="True" Click="OnAlignPlacedMenu"
                                              ToolTipService.ToolTip="An object placed beside another turns parallel to it and slides until their edges meet: floor tiles and wall panels come out joined. Hold Alt while clicking to place one exactly where you click."><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="BlenderKeysMenu" Text="Blender shortcuts (G move, R turn, S scale)" Click="OnBlenderKeysMenu"
                                              ToolTipService.ToolTip="With an object selected, G moves, R turns and S scales it with the mouse alone, without the gizmo. X, Y or Z keeps it to one axis (Shift: the plane without it), digits type the exact amount, a click or Enter keeps the result, the right button or Esc drops it."><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Frame selection" Click="OnFrameSelection"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSubItem Text="Field of view">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE722;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="Narrow  30°" Tag="30" Click="OnFieldOfViewMenu" />
                        <MenuFlyoutItem Text="Default  45°" Tag="45" Click="OnFieldOfViewMenu" />
                        <MenuFlyoutItem Text="Wide  60°" Tag="60" Click="OnFieldOfViewMenu" />
                        <MenuFlyoutItem Text="Interior  80°" Tag="80" Click="OnFieldOfViewMenu" />
                        <MenuFlyoutItem Text="Very wide  100°" Tag="100" Click="OnFieldOfViewMenu" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Ctrl + mouse wheel over the view" IsEnabled="False" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Shading">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="ShadeMaterial" Text="Game materials (textures near the camera)" GroupName="Shading" Tag="Material" Click="OnShadingMenu" />
                        <RadioMenuFlyoutItem x:Name="ShadeTinted" Text="Tint by resource" GroupName="Shading" Tag="Tinted" Click="OnShadingMenu" />
                        <RadioMenuFlyoutItem x:Name="ShadeClay" Text="Clay" GroupName="Shading" Tag="Clay" Click="OnShadingMenu" />
                        <RadioMenuFlyoutItem x:Name="ShadeType" Text="By node type" GroupName="Shading" Tag="NodeType" Click="OnShadingMenu" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="SurfacesMenu" Text="Road textures (Material shading)" IsChecked="True" Click="OnSurfacesMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE913;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="DecalsMenu" Text="Decals (Material shading)" IsChecked="True" Click="OnDecalsMenu"
                                              ToolTipService.ToolTip="Graffiti, stains, markings and signs the game projects onto walls and ground, drawn as it draws them."><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem x:Name="WireframeMenu" Text="Wireframe" Click="OnWireframeMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="GameFacesMenu" Text="Faces as the game draws them (backs hidden)" Click="OnGameFacesMenu"
                                          ToolTipService.ToolTip="On: a surface the game draws from its front only (most walls, floors and props) is not drawn from behind, so a facade seen from inside a room is not there, as in game; leaves, cloth and glass keep both sides. Off: both sides of everything."><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE7FC;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- What is drawn over the scene to work with it. -->
                    <MenuFlyoutSubItem Text="Overlays">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE890;" /></MenuFlyoutSubItem.Icon>
                        <ToggleMenuFlyoutItem x:Name="SelectionBoundsMenu" Text="Selection and hover boxes" IsChecked="True" Click="OnSelectionBoundsMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="CollisionMenu" Text="Collision shapes" Click="OnCollisionMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="TrafficMenu" Text="Traffic paths around the camera" Click="OnTrafficMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE7EC;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="SectorBoundsMenu" Text="Sector bounds" Click="OnSectorBoundsMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xECA5;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="PlaceholderMenu" Text="Show unsupported placeholders" Click="OnPlaceholderMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE9CE;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Icons">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutSubItem.Icon>
                        <!-- The project's own elements, then the game's: each with its distance. -->
                        <ToggleMenuFlyoutItem x:Name="ProjectIconsMenu" Text="Your project's elements" IsChecked="True" Click="OnProjectIconsMenu"
                                              ToolTipService.ToolTip="The icons of the lights, effects, sounds, decals and doors you added. Off: only the selected ones show, and the Elements tool, which works on them, still shows them all."><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EC;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <MenuFlyoutSubItem Text="Their distance">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81D;" /></MenuFlyoutSubItem.Icon>
                            <RadioMenuFlyoutItem x:Name="ProjectIconRange10" Text="10 m" GroupName="ProjectIconRange" Tag="10" Click="OnProjectIconRangeMenu" />
                            <RadioMenuFlyoutItem x:Name="ProjectIconRange25" Text="25 m" GroupName="ProjectIconRange" Tag="25" Click="OnProjectIconRangeMenu" />
                            <RadioMenuFlyoutItem x:Name="ProjectIconRange50" Text="50 m" GroupName="ProjectIconRange" Tag="50" Click="OnProjectIconRangeMenu" />
                            <RadioMenuFlyoutItem x:Name="ProjectIconRange75" Text="75 m" GroupName="ProjectIconRange" Tag="75" Click="OnProjectIconRangeMenu" />
                            <RadioMenuFlyoutItem x:Name="ProjectIconRange150" Text="150 m" GroupName="ProjectIconRange" Tag="150" Click="OnProjectIconRangeMenu" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="MarkersMenu" Text="The game's lights, sounds and effects" Click="OnMarkersMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xEA80;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem x:Name="DoorIconsMenu" Text="The game's doors" Click="OnDoorIconsMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A1;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                        <MenuFlyoutItem Text="Distance of the game's icons" IsEnabled="False" />
                        <RadioMenuFlyoutItem x:Name="IconRange25" Text="25 m" GroupName="IconRange" Tag="25" Click="OnIconRangeMenu" />
                        <RadioMenuFlyoutItem x:Name="IconRange50" Text="50 m" GroupName="IconRange" Tag="50" Click="OnIconRangeMenu" />
                        <RadioMenuFlyoutItem x:Name="IconRange100" Text="100 m" GroupName="IconRange" Tag="100" Click="OnIconRangeMenu" />
                        <RadioMenuFlyoutItem x:Name="IconRange200" Text="200 m" GroupName="IconRange" Tag="200" Click="OnIconRangeMenu" />
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <!-- What of the game's world is shown and played around the camera, and how it loads. -->
                <MenuBarItem Title="World">
                    <ToggleMenuFlyoutItem x:Name="DistantMenu" Text="Distant city (proxies)" IsChecked="True" Click="OnDistantMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE825;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <!-- Nothing drawn beyond a distance, for slower machines (MainWindow.DrawDistance). -->
                    <MenuFlyoutSubItem Text="Draw distance"
                                       ToolTipService.ToolTip="Nothing further than this from the camera is drawn, to lighten the view on slower machines; with the sky on, what nears the limit fades into it. It does not change what is loaded: the view presets of the toolbar and Loading, below, decide that.">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7B3;" /></MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="DrawDistanceNone" Text="No limit" GroupName="DrawDistance" Tag="0" IsChecked="True" Click="OnDrawDistanceMenu" />
                        <RadioMenuFlyoutItem x:Name="DrawDistance100" Text="100 m" GroupName="DrawDistance" Tag="100" Click="OnDrawDistanceMenu" />
                        <RadioMenuFlyoutItem x:Name="DrawDistance200" Text="200 m" GroupName="DrawDistance" Tag="200" Click="OnDrawDistanceMenu" />
                        <RadioMenuFlyoutItem x:Name="DrawDistance400" Text="400 m" GroupName="DrawDistance" Tag="400" Click="OnDrawDistanceMenu" />
                        <RadioMenuFlyoutItem x:Name="DrawDistance800" Text="800 m" GroupName="DrawDistance" Tag="800" Click="OnDrawDistanceMenu" />
                        <RadioMenuFlyoutItem x:Name="DrawDistanceOther" Text="Other distance…" GroupName="DrawDistance" Tag="other" Click="OnDrawDistanceMenu" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem x:Name="AtmosphereMenu" Text="Sky and distance fog" Click="OnAtmosphereMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE753;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="NightMenu" Text="Night lighting preview (lights)" Click="OnNightMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE708;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="VariantsMenu" Text="Quest variants"
                                       ToolTipService.ToolTip="Places have states that quests switch on and off (barriers, story props, wrecks). The world is shown as the game starts it; show the others here.">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7C1;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="PlayEffectsMenu" Text="Play visual effects around the camera" IsChecked="True" Click="OnPlayEffectsMenu"
                                          ToolTipService.ToolTip="The particle systems and effects of the game and of the project near the camera play in the view (fire, smoke, steam, sparks, dust), simulated from the game's own files. Screen effects, trails, beams and distortion are not drawn."><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xECAD;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="HearGameSoundsMenu" Text="Hear the game's sounds around the camera" Click="OnHearGameSoundsMenu"
                                          ToolTipService.ToolTip="The game's sound emitters near the camera play the event they play in game (ambiences, machines, crowds), each from its place. Rooms, reverb and what the game mixes by situation are not reproduced."><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE767;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="HearSoundsMenu" Text="Hear custom sounds around the camera" Click="OnHearSoundsMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D6;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Loading follows the camera, or is held on one place (StudioSession.Loading). -->
                    <MenuFlyoutSubItem x:Name="LoadingMenu" Text="Loading"
                                       ToolTipService.ToolTip="The world loads around the camera as it moves. Freeze it to work on one place without anything arriving or leaving: keep what is loaded, or load a distance around the camera first.">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="LoadingFollow" Text="Follow the camera" GroupName="LoadingHold" Tag="follow" IsChecked="True" Click="OnLoadingMenu" />
                        <RadioMenuFlyoutItem x:Name="LoadingKeep" Text="Freeze: keep what is loaded" GroupName="LoadingHold" Tag="keep" Click="OnLoadingMenu" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Freeze after loading around the camera" IsEnabled="False" />
                        <RadioMenuFlyoutItem x:Name="LoadingArea150" Text="150 m" GroupName="LoadingHold" Tag="150" Click="OnLoadingMenu" />
                        <RadioMenuFlyoutItem x:Name="LoadingArea300" Text="300 m" GroupName="LoadingHold" Tag="300" Click="OnLoadingMenu" />
                        <RadioMenuFlyoutItem x:Name="LoadingArea600" Text="600 m" GroupName="LoadingHold" Tag="600" Click="OnLoadingMenu" />
                        <RadioMenuFlyoutItem x:Name="LoadingArea1000" Text="1 000 m" GroupName="LoadingHold" Tag="1000" Click="OnLoadingMenu" />
                        <RadioMenuFlyoutItem x:Name="LoadingAreaOther" Text="Other distance…" GroupName="LoadingHold" Tag="other" Click="OnLoadingMenu" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem x:Name="PreflightMenu" Text="Preload surroundings in the background" IsChecked="True" Click="OnPreflightMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F5;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <MenuFlyoutItem Text="Prepare cache for the whole city" Click="OnPrepareCity"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE826;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="Window">
                    <MenuFlyoutItem Text="Library…" Click="OnOpenLibrary">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="L" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="ToolbarVerticalMenu" Text="Vertical floating toolbar" Click="OnToolbarVerticalMenu"><ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE784;" /></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                    <MenuFlyoutItem Text="Reset floating toolbar position" Click="OnResetToolbar"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="Collaborate">
                    <MenuFlyoutItem Text="Share this world…" Click="OnShareWorld" ToolTipService.ToolTip="A shared world in your cloud: the people you invite work on it with you, live, or continue it when you are away">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Join a shared world…" Click="OnJoinSharedWorld" ToolTipService.ToolTip="Enter the invite code someone gave you"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open a shared world…" Click="OnOpenFromCloud" ToolTipService.ToolTip="Your worlds and those shared with you (File ▸ Open from the cloud)"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE753;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Start a live session…" Click="OnStartSession" ToolTipService.ToolTip="A one-off session with a code and a password (the world is not shared in your cloud)"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE716;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Join a live session…" Click="OnJoinSession"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Session panel" Click="OnShowSessionPanel"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CopyInvitationMenu" Text="Copy the invitation" Click="OnCopyInvitation" IsEnabled="False"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="LeaveSessionMenu" Text="Leave the session" Click="OnLeaveSession" IsEnabled="False"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="AI agents (MCP)…" Click="OnOpenMcp"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE99A;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Keyboard shortcuts…" Click="OnShortcuts"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Controls" Click="OnShowControls"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C9;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Record crash dumps…" Click="OnRecordDumps" ToolTipService.ToolTip="Asks Windows (administrator prompt) to keep a dump when NCWE crashes, so a crash with no log can be explained"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEBE8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open the logs folder" Click="OnOpenLogs" ToolTipService.ToolTip="exceptions.log, last-crash-studio.txt, last-crash-windows.txt: send them with a bug report"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="LanguageMenu" Text="Language">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Credits and licenses…" Click="OnCredits" ToolTipService.ToolTip="The projects NCWE thanks, its license and every third-party license"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB51;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="About NCWE" Click="OnAbout"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>
            <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,12,0">
                <Ellipse x:Name="DirtyDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                <Grid VerticalAlignment="Center">
                    <Button x:Name="ProjectTitleButton" Style="{StaticResource TitleBarLinkStyle}" Padding="8,0" Click="OnProjectTitleClick"
                            PointerEntered="OnProjectTitleEnter" PointerExited="OnProjectTitleExit" ToolTipService.ToolTip="Rename the world">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="ProjectTitle" Text="Untitled world" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13" />
                            <FontIcon x:Name="ProjectTitleIcon" Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Opacity="0" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="ProjectTitleBox" Visibility="Collapsed" MinWidth="240" MaxWidth="380" MinHeight="28" Padding="8,3" FontSize="13" VerticalAlignment="Center"
                             PlaceholderText="World name" MaxLength="200" KeyDown="OnProjectTitleKey" LostFocus="OnProjectTitleLost" />
                </Grid>
                <Rectangle Width="1" Height="16" Fill="{StaticResource HairlineBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <!-- Live collaboration: start or join; in a session, its state and who is in it -->
                <Button x:Name="CollabButton" Style="{StaticResource TitleBarLinkStyle}" Padding="8,0" Click="OnCollabButton"
                        ToolTipService.ToolTip="Build this world together, live (Open//77 account)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Grid VerticalAlignment="Center">
                            <FontIcon x:Name="CollabIcon" Glyph="&#xE716;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Ellipse x:Name="CollabDot" Width="7" Height="7" Fill="#3DDC84" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="CollabLabel" Text="Collaborate" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <!-- Open//77 account: sign in (cloud saves and collaboration need it), or who is signed in -->
                <Button x:Name="AccountButton" Style="{StaticResource TitleBarLinkStyle}" Padding="8,0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="AccountAvatar" Fill="#22E4F2" Visibility="Collapsed" />
                            <TextBlock x:Name="AccountInitial" FontSize="10" FontWeight="SemiBold" Foreground="#06121A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FontIcon x:Name="AccountIcon" Glyph="&#xE77B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="AccountLabel" Text="Sign in" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="AccountMenu" Placement="BottomEdgeAlignedRight" Opening="OnAccountMenuOpening" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="Open77Button" Style="{StaticResource TitleBarLinkStyle}" Click="OnOpen77Site"
                        ToolTipService.ToolTip="NCWE is made by the Open//77 team, the multiplayer platform for Cyberpunk 2077. Opens open2077.net">
                    <Image Source="ms-appx:///Assets/open77-logo-dark.png" Height="12" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Workspace ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SidebarColumn" Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Viewport and its floating chrome -->
            <Grid x:Name="ViewportArea" Grid.Column="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,1" Background="#141518">
                <ContentControl x:Name="ViewportFocus" IsTabStop="True" UseSystemFocusVisuals="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <SwapChainPanel x:Name="Viewport" />
                </ContentControl>

                <Canvas x:Name="ToolbarCanvas">
                    <!-- Floating toolbar: drag it by the grip; horizontal or vertical (grip's menu, double-click, Window menu). -->
                    <Border x:Name="FloatingToolbar" Style="{StaticResource FloatingCardStyle}" Padding="2" Canvas.Left="300" Canvas.Top="8">
                        <StackPanel x:Name="ToolbarItems" Orientation="Horizontal" Spacing="4">
                            <local:GripBorder x:Name="ToolbarGrip" Width="18" Background="Transparent" ToolTipService.ToolTip="Drag to move the toolbar · double-click or right-click: horizontal or vertical" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              DoubleTapped="OnToolbarGripDoubleTapped">
                                <local:GripBorder.ContextFlyout>
                                    <MenuFlyout>
                                        <RadioMenuFlyoutItem x:Name="ToolbarHorizontalItem" Text="Horizontal toolbar" GroupName="ToolbarOrientation" Tag="Horizontal" Click="OnToolbarOrientation" />
                                        <RadioMenuFlyoutItem x:Name="ToolbarVerticalItem" Text="Vertical toolbar" GroupName="ToolbarOrientation" Tag="Vertical" Click="OnToolbarOrientation" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Reset its position" Click="OnResetToolbar" />
                                    </MenuFlyout>
                                </local:GripBorder.ContextFlyout>
                                <FontIcon x:Name="ToolbarGripIcon" Glyph="&#xE784;" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" />
                            </local:GripBorder>
                            <ToggleButton x:Name="FlyModeButton" Style="{StaticResource BarToggleStyle}" Click="OnFlyMode" ToolTipService.ToolTip="Fly freely (Tab toggles)">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE709;" FontSize="14" /><TextBlock Text="Fly" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="WalkModeButton" Style="{StaticResource BarToggleStyle}" Click="OnWalkMode" ToolTipService.ToolTip="Walk on the ground like in game (Tab toggles)">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE805;" FontSize="14" /><TextBlock Text="Walk" /></StackPanel>
                            </ToggleButton>
                            <Rectangle Width="1" Height="20" Fill="{StaticResource HairlineBrush}" Margin="4,0" VerticalAlignment="Center" />
                            <ToggleButton x:Name="SceneLayerButton" Style="{StaticResource BarToggleStyle}" Click="OnLayerClick" Tag="Scene" IsChecked="True" ToolTipService.ToolTip="Edit the scene: meshes, entities, elements">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF158;" FontSize="13" /><TextBlock Text="Scene" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="CollisionLayerButton" Style="{StaticResource BarToggleStyle}" Click="OnLayerClick" Tag="Collision" ToolTipService.ToolTip="Edit collision: clicks, rectangles and the gizmo work on collision">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE81E;" FontSize="13" /><TextBlock Text="Collision" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="OcclusionLayerButton" Style="{StaticResource BarToggleStyle}" Click="OnLayerClick" Tag="Occlusion" ToolTipService.ToolTip="Edit occlusion: occluders, and the occlusion settings of meshes">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7B3;" FontSize="13" /><TextBlock Text="Occlusion" /></StackPanel>
                            </ToggleButton>
                            <Rectangle Width="1" Height="20" Fill="{StaticResource HairlineBrush}" Margin="4,0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xEC4A;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <Slider x:Name="SpeedSlider" Width="110" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="6,0,0,0"
                                        ValueChanged="OnSpeedChanged" ToolTipService.ToolTip="Fly speed (mouse wheel over the viewport)" IsThumbToolTipEnabled="False" />
                                <TextBlock x:Name="SpeedLabel" Text="25 m/s" Width="58" Style="{StaticResource ValueStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <Button x:Name="FieldOfViewButton" Style="{StaticResource BarButtonStyle}" Click="OnFieldOfViewReset" ToolTipService.ToolTip="Field of view: Ctrl + mouse wheel over the viewport. Click to reset to 45°">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE722;" FontSize="14" /><TextBlock x:Name="FieldOfViewLabel" Text="45°" MinWidth="26" Style="{StaticResource ValueStyle}" /></StackPanel>
                            </Button>
                            <Rectangle Width="1" Height="20" Fill="{StaticResource HairlineBrush}" Margin="4,0" VerticalAlignment="Center" />
                            <ToggleButton x:Name="LocalSpaceButton" Style="{StaticResource BarToggleStyle}" Click="OnSpaceToggle" ToolTipService.ToolTip="Gizmo axes: local object space or world space">
                                <TextBlock x:Name="SpaceLabel" Text="Local" />
                            </ToggleButton>
                            <ToggleButton x:Name="SnapButton" Style="{StaticResource BarToggleStyle}" Click="OnSnapToggle" ToolTipService.ToolTip="Snap moves and rotations to steps">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE80A;" FontSize="14" /><TextBlock Text="Snap" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="SnapObjectsButton" Style="{StaticResource BarToggleStyle}" Click="OnSnapObjectsToggle"
                                          ToolTipService.ToolTip="Snap to objects: a move lines the selection up with the faces of nearby objects (hold Alt to move freely). Hold V and drag for vertex-to-vertex or onto a surface.">
                                <FontIcon Glyph="&#xE71B;" FontSize="14" />
                            </ToggleButton>
                            <DropDownButton x:Name="PivotButton" Height="28" Padding="8,0" CornerRadius="0" Background="Transparent" BorderThickness="0" FontSize="12"
                                            ToolTipService.ToolTip="Pivot of several selected objects: what they turn and scale around">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE81D;" FontSize="13" /><TextBlock x:Name="PivotLabel" Text="Active" /></StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <RadioMenuFlyoutItem x:Name="PivotActive" Text="Active object (the last selected)" GroupName="Pivot" Tag="Active" Click="OnPivotMode" />
                                        <RadioMenuFlyoutItem x:Name="PivotCenter" Text="Selection centre" GroupName="Pivot" Tag="Center" Click="OnPivotMode" />
                                        <RadioMenuFlyoutItem x:Name="PivotIndividual" Text="Each object's own origin" GroupName="Pivot" Tag="Individual" Click="OnPivotMode" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Rectangle Width="1" Height="20" Fill="{StaticResource HairlineBrush}" Margin="4,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="DistanceBox" Width="136" Height="32" VerticalAlignment="Center" SelectionChanged="OnDistanceChanged" ToolTipService.ToolTip="How far around the camera the world is streamed">
                                <ComboBoxItem Content="Near view" />
                                <ComboBoxItem Content="Medium view" />
                                <ComboBoxItem Content="Far view" />
                            </ComboBox>
                            <DropDownButton x:Name="MaterialsButton" Height="28" Padding="8,0" CornerRadius="0" Background="Transparent" BorderThickness="0" FontSize="12"
                                            ToolTipService.ToolTip="Game materials: textures, normal maps, glass, water and lights on what is near the camera">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE790;" FontSize="13" /><TextBlock x:Name="MaterialsLabel" Text="120 m" /></StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout Placement="Bottom" Opened="OnMaterialsFlyoutOpened">
                                        <StackPanel Width="300" Spacing="10">
                                            <TextBlock Text="Game materials" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                                       Text="Within this distance, objects show their game materials (textures, relief, metal, glass, water, neon). Farther away they keep a flat color: lower the distance if the editor slows down." />
                                            <ToggleSwitch x:Name="MaterialsSwitch" Header="Show game materials" OnContent="On (Material shading)" OffContent="Off: flat colors" Toggled="OnMaterialsSwitch" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Distance" Style="{StaticResource PropLabelStyle}" />
                                                <Slider x:Name="MaterialRangeSlider" Grid.Column="1" Minimum="20" Maximum="600" StepFrequency="10" ValueChanged="OnMaterialRange" />
                                                <TextBlock x:Name="MaterialRangeText" Grid.Column="2" Style="{StaticResource ValueStyle}" VerticalAlignment="Center" Width="44" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Textures" Style="{StaticResource PropLabelStyle}" />
                                                <ComboBox x:Name="TextureQualityBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnTextureQuality">
                                                    <ComboBoxItem Content="Light (512 px)" Tag="512" />
                                                    <ComboBoxItem Content="Standard (1024 px)" Tag="1024" />
                                                    <ComboBoxItem Content="High (2048 px)" Tag="2048" />
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock x:Name="MaterialStats" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <ToggleButton x:Name="WireframeButton" Style="{StaticResource BarToggleStyle}" Click="OnWireframeToggle" ToolTipService.ToolTip="Wireframe">
                                <FontIcon Glyph="&#xE81E;" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton x:Name="AtmosphereButton" Style="{StaticResource BarToggleStyle}" Click="OnAtmosphereToggle" ToolTipService.ToolTip="Sky and distance fog">
                                <FontIcon Glyph="&#xE706;" FontSize="14" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Toolbox, top left -->
                <Border x:Name="ToolBox" Style="{StaticResource FloatingCardStyle}" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                    <StackPanel Spacing="1">
                        <ToggleButton x:Name="SelectTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE7C9;" Click="OnToolClick" Tag="Select" ToolTipService.ToolTip="Select  (1)" />
                        <ToggleButton x:Name="MoveTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE7C2;" Click="OnToolClick" Tag="Move" ToolTipService.ToolTip="Move  (2)" />
                        <ToggleButton x:Name="RotateTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE7AD;" Click="OnToolClick" Tag="Rotate" ToolTipService.ToolTip="Rotate  (3)" />
                        <ToggleButton x:Name="ScaleTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE740;" Click="OnToolClick" Tag="Scale" ToolTipService.ToolTip="Scale  (4)" />
                        <ToggleButton x:Name="PlaceTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE710;" Click="OnToolClick" Tag="Place" ToolTipService.ToolTip="Place the prop chosen in Add  (5)" />
                        <ToggleButton x:Name="RoadTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE804;" Click="OnToolClick" Tag="Road" ToolTipService.ToolTip="Roads: draw, bend and edit roads  (6)" />
                        <ToggleButton x:Name="ElementTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE781;" Click="OnToolClick" Tag="Element" ToolTipService.ToolTip="Elements: place and edit lights, effects, sounds and decals  (7)" />
                        <ToggleButton x:Name="TrafficTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE819;" Click="OnToolClick" Tag="Traffic" ToolTipService.ToolTip="Traffic paths: see, edit, link, delete and draw the lanes vehicles and pedestrians follow  (8)" />
                        <ToggleButton x:Name="ElevatorTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE8CB;" Click="OnToolClick" Tag="Elevator" ToolTipService.ToolTip="Elevators: place an elevator, then click on each level of the building where it stops  (9)" />
                        <ToggleButton x:Name="TerrainTool" Style="{StaticResource ToolButtonStyle}" Content="&#xE909;" Click="OnToolClick" Tag="Terrain" ToolTipService.ToolTip="Terrain: raise, dig, smooth and flatten the ground, make mountains, cut holes and paint its materials  (0)" />
                        <ToggleButton x:Name="MeshEditToolButton" Style="{StaticResource ToolButtonStyle}" Content="&#xE70F;" Click="OnMeshEditToggle" ToolTipService.ToolTip="Edit mesh: open walls for windows and doors, move vertices and faces, change UVs of the selected mesh  (M)" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" FontSize="15" Content="&#xE8F1;" Click="OnOpenLibrary" ToolTipService.ToolTip="Library window: big cards, favorites, appearances  (Ctrl+L)" />
                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="4,3" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE71E;" Click="OnFrameSelection" ToolTipService.ToolTip="Focus selection  (F)" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE74B;" Click="OnDropToGround" ToolTipService.ToolTip="Drop to ground  (End)" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE8C8;" Click="OnDuplicate" ToolTipService.ToolTip="Duplicate  (Ctrl+D)" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE74D;" Click="OnDelete" ToolTipService.ToolTip="Delete  (Del)" />
                    </StackPanel>
                </Border>

                <!-- Navigation hint -->
                <Border x:Name="HintCard" Background="#B3141518" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0" IsHitTestVisible="False">
                    <TextBlock x:Name="HintText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>

                <!-- The agent's messages (MCP tool narrate): a read-only feed, newest at the bottom. Only its
                     header (hide or show) takes the mouse. -->
                <Grid x:Name="AgentFeed" Width="344" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="54,62,0,34" Visibility="Collapsed">
                    <Grid x:Name="AgentFeedArea">
                        <StackPanel x:Name="AgentFeedStack" VerticalAlignment="Bottom" Spacing="8" SizeChanged="OnAgentFeedSize">
                            <Border x:Name="AgentFeedHeader" HorizontalAlignment="Left" CornerRadius="12" Padding="10,3,3,3" Background="#E60E1116" BorderBrush="#4022E4F2" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AgentFeedName" Text="AI" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AgentFeedCount" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="AgentFeedToggle" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" FontSize="10" Content="&#xE70E;" Click="OnAgentFeedToggle"
                                            ToolTipService.ToolTip="Hide the agent's messages" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Loading held on one place (World ▸ Loading), above the streaming indicator -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="2">
                    <Border x:Name="HoldCard" Background="#CC141518" Padding="9,3,4,3" HorizontalAlignment="Right" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="HoldIcon" Glyph="&#xE769;" FontSize="12" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HoldText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="HoldResume" Style="{StaticResource BarButtonStyle}" Height="22" MinHeight="22" Padding="8,0" FontSize="11" Content="Resume" Click="OnResumeLoading"
                                    ToolTipService.ToolTip="The world loads around the camera again (World ▸ Loading)" />
                        </StackPanel>
                    </Border>
                    <!-- Streaming indicator -->
                    <Border x:Name="StreamingCard" Background="#B3141518" Padding="8,4" HorizontalAlignment="Right" Margin="0" IsHitTestVisible="False" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="StreamingRing" Width="12" Height="12" IsActive="True" Foreground="{StaticResource CyanBrush}" />
                            <TextBlock x:Name="StreamingText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Field of view, shown briefly after Ctrl + wheel -->
                <Border x:Name="FieldOfViewToast" Style="{StaticResource FloatingCardStyle}" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE722;" FontSize="16" />
                        <TextBlock x:Name="FieldOfViewToastText" Text="45°" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Crosshair while walking -->
                <Ellipse x:Name="Crosshair" Width="5" Height="5" Fill="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />

                <!-- Welcome / loading card -->
                <Border x:Name="WelcomeCard" Style="{StaticResource FloatingCardStyle}" Padding="20" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Night City World Editor" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="WelcomeSubtitle" Text="Select a game installation to start." Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="LoadingPanel" Spacing="10" Visibility="Collapsed">
                            <ProgressBar IsIndeterminate="True" />
                            <TextBlock x:Name="LoadingText" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="ChooseGamePanel" Spacing="10">
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Choose your Cyberpunk 2077 installation. NCWE only reads the vanilla archives; your game files are never modified." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Click="OnBrowseGame">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14" /><TextBlock Text="Choose installation…" /></StackPanel>
                                </Button>
                                <Button x:Name="DetectedGameButton" Click="OnUseDetectedGame" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="WelcomeRecentPanel" Spacing="6" Visibility="Collapsed" Margin="0,4,0,0">
                            <TextBlock Text="RECENT PROJECTS" Style="{StaticResource PaneTitleStyle}" />
                            <StackPanel x:Name="WelcomeRecentList" Spacing="2" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,2,0,0" />
                        <Button Style="{StaticResource TitleBarLinkStyle}" Click="OnOpen77Site" Padding="0" HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Opens open2077.net">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Made by" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                <Image Source="ms-appx:///Assets/open77-logo-dark.png" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="the multiplayer platform for Cyberpunk 2077" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sidebar resize handle -->
            <local:SizerGrid x:Name="SidebarSizer" Grid.Column="1" Width="4" Background="{StaticResource ShellBackgroundBrush}" />

            <!-- ===== Right sidebar: the outliner over the property panels ===== -->
            <Grid x:Name="Sidebar" Grid.Column="2" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,1,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="OutlinerRowDef" Height="340" MinHeight="150" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="220" />
                </Grid.RowDefinitions>

                <!-- ===== Outliner ===== -->
                <Grid x:Name="OutlinerPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{StaticResource PaneHeaderBrush}" Padding="10,0,6,0" ColumnSpacing="6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FD;" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="OUTLINER" Style="{StaticResource PaneTitleStyle}" />
                        </StackPanel>
                        <Border Grid.Column="2" BorderBrush="{StaticResource StrongHairlineBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ProjectScopeButton" Style="{StaticResource SegmentToggleStyle}" Content="Project" IsChecked="True" Click="OnOutlinerScope" Tag="Project"
                                              ToolTipService.ToolTip="Your project: what you added, edited or deleted, organised in folders" />
                                <ToggleButton x:Name="WorldScopeButton" Style="{StaticResource SegmentToggleStyle}" Content="World" Click="OnOutlinerScope" Tag="World"
                                              ToolTipService.ToolTip="Every object loaded around the camera" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
                            <Button x:Name="NewFolderButton" Style="{StaticResource PaneIconButtonStyle}" Content="&#xE8F4;" Click="OnNewFolder" ToolTipService.ToolTip="New folder (with the selected objects)  Ctrl+G" />
                            <Button x:Name="ExpandAllButton" Style="{StaticResource PaneIconButtonStyle}" Content="&#xE8A9;" Click="OnExpandAll" ToolTipService.ToolTip="Expand or collapse every folder" />
                            <Button x:Name="OutlinerFilterButton" Style="{StaticResource PaneIconButtonStyle}" Content="&#xE71C;" ToolTipService.ToolTip="Show only some kinds of objects">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <ToggleMenuFlyoutItem x:Name="FilterMeshes" Text="Meshes" IsChecked="True" Click="OnOutlinerFilter" />
                                        <ToggleMenuFlyoutItem x:Name="FilterLights" Text="Lights" IsChecked="True" Click="OnOutlinerFilter" />
                                        <ToggleMenuFlyoutItem x:Name="FilterEffects" Text="Effects, decals and sounds" IsChecked="True" Click="OnOutlinerFilter" />
                                        <ToggleMenuFlyoutItem x:Name="FilterEntities" Text="Doors and entities" IsChecked="True" Click="OnOutlinerFilter" />
                                        <ToggleMenuFlyoutItem x:Name="FilterCollision" Text="Collision and occluders" IsChecked="True" Click="OnOutlinerFilter" />
                                        <ToggleMenuFlyoutItem x:Name="FilterRoads" Text="Roads" IsChecked="True" Click="OnOutlinerFilter" />
                                        <ToggleMenuFlyoutItem x:Name="FilterTraffic" Text="Traffic lanes" IsChecked="True" Click="OnOutlinerFilter" />
                                        <ToggleMenuFlyoutItem x:Name="FilterGame" Text="Edited game objects" IsChecked="True" Click="OnOutlinerFilter" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Padding="8,8,8,6" Spacing="6">
                        <TextBox x:Name="OutlinerSearch" PlaceholderText="Filter by name…" TextChanged="OnOutlinerSearch" />
                        <Grid x:Name="ActiveFolderBar" ColumnSpacing="6" Visibility="Collapsed" Padding="8,3,2,3" Background="{StaticResource AccentSoftBrush}" CornerRadius="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F4;" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ActiveFolderText" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Style="{StaticResource PaneIconButtonStyle}" Width="22" Height="22" FontSize="10" Content="&#xE711;" Click="OnClearActiveFolder"
                                    ToolTipService.ToolTip="New objects go to the root again" />
                        </Grid>
                        <Grid x:Name="IsolationBar" ColumnSpacing="6" Visibility="Collapsed" Padding="8,3,2,3" Background="#33E8934A" CornerRadius="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7B3;" FontSize="12" Foreground="#E8934A" VerticalAlignment="Center" />
                            <TextBlock x:Name="IsolationText" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Style="{StaticResource PaneIconButtonStyle}" Width="22" Height="22" FontSize="10" Content="&#xE711;" Click="OnExitIsolation"
                                    ToolTipService.ToolTip="See everything again (Shift+H)" />
                        </Grid>
                    </StackPanel>

                    <!-- Project hierarchy -->
                    <Grid x:Name="ProjectTreePane" Grid.Row="2">
                        <ListView x:Name="OutlinerList" SelectionMode="None" IsItemClickEnabled="False" CanDragItems="True" AllowDrop="True" Padding="0,0,0,8"
                                  DragItemsStarting="OnOutlinerDragStarting" DragOver="OnOutlinerListDragOver" Drop="OnOutlinerListDrop"
                                  KeyDown="OnOutlinerKey" RightTapped="OnOutlinerBackgroundRightTapped" IsTabStop="True">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="CornerRadius" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:OutlinerRow">
                                    <Grid Height="26" Background="{x:Bind Background, Mode=OneWay}" AllowDrop="True" Tag="{x:Bind}"
                                          Tapped="OnOutlinerRowTapped" DoubleTapped="OnOutlinerRowDoubleTapped" RightTapped="OnOutlinerRowRightTapped"
                                          DragOver="OnOutlinerRowDragOver" DragLeave="OnOutlinerRowDragLeave" Drop="OnOutlinerRowDrop">
                                        <Rectangle Width="3" HorizontalAlignment="Left" Fill="{x:Bind TagBrush, Mode=OneWay}" Opacity="{x:Bind TagOpacity, Mode=OneWay}" />
                                        <Rectangle Width="2" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{StaticResource AccentBrush}" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                                        <Grid Padding="{x:Bind Indent, Mode=OneWay}" ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <Button Width="16" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="OnOutlinerChevron"
                                                    Visibility="{x:Bind ChevronVisibility, Mode=OneWay}" IsTabStop="False">
                                                <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="13" Foreground="{x:Bind IconBrush, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Name, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Opacity="{x:Bind TextOpacity, Mode=OneWay}" Visibility="{x:Bind NameVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />
                                            <TextBox Grid.Column="2" Text="{x:Bind Name, Mode=OneWay}" Visibility="{x:Bind EditVisibility, Mode=OneWay}" Tag="{x:Bind}"
                                                     MinHeight="22" Height="22" Padding="5,1,4,1" FontSize="12.5" KeyDown="OnOutlinerRenameKey" LostFocus="OnOutlinerRenameLost" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Trailing, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Width="20" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="OnOutlinerEye"
                                                    Visibility="{x:Bind FlagsVisibility, Mode=OneWay}" IsTabStop="False" ToolTipService.ToolTip="{x:Bind EyeTip, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind EyeGlyph, Mode=OneWay}" FontSize="12" Opacity="{x:Bind EyeOpacity, Mode=OneWay}" Foreground="{x:Bind EyeBrush, Mode=OneWay}" />
                                            </Button>
                                            <Button Grid.Column="5" Width="20" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="OnOutlinerLock"
                                                    Visibility="{x:Bind FlagsVisibility, Mode=OneWay}" IsTabStop="False" ToolTipService.ToolTip="{x:Bind LockTip, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind LockGlyph, Mode=OneWay}" FontSize="12" Opacity="{x:Bind LockOpacity, Mode=OneWay}" Foreground="{x:Bind LockBrush, Mode=OneWay}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="OutlinerEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Padding="24,0" Visibility="Collapsed" IsHitTestVisible="False">
                            <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock x:Name="OutlinerEmptyTitle" Text="Your project is empty" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="OutlinerEmptyText" Style="{StaticResource HintStyle}" TextAlignment="Center"
                                       Text="What you add or edit in the world shows up here. Create folders to organise it: drag objects onto them, right-click for colours." />
                        </StackPanel>
                    </Grid>

                    <!-- Objects loaded around the camera -->
                    <Grid x:Name="WorldObjectsPane" Grid.Row="2" Visibility="Collapsed" RowSpacing="4" Padding="8,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="EntityCount" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                            <CheckBox x:Name="EditableOnly" Content="Editable only" HorizontalAlignment="Right" MinWidth="0" MinHeight="0" Padding="6,0,0,0" FontSize="11.5" Click="OnEntityFilter" />
                        </Grid>
                        <ListView x:Name="EntityList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="OnEntitySelected" DoubleTapped="OnEntityDoubleTapped" Margin="-8,0,-8,0"
                                  ToolTipService.ToolTip="Ctrl/Shift for several · double-click to focus">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:EntityItem">
                                    <Grid Padding="0,1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{x:Bind KindForeground}" VerticalAlignment="Center" Width="16" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Outliner / properties splitter -->
                <local:SizerGrid x:Name="OutlinerSizer" Grid.Row="1" Vertical="True" Background="{StaticResource ShellBackgroundBrush}" />

                <!-- ===== Property panels ===== -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PaneHeaderBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <SelectorBar x:Name="SidebarTabs" Margin="4,0,4,0" SelectionChanged="OnSidebarTab">
                            <SelectorBarItem x:Name="InspectorTab" Text="Inspector" Tag="Inspector" IsSelected="True"><SelectorBarItem.Icon><FontIcon Glyph="&#xE90F;" /></SelectorBarItem.Icon></SelectorBarItem>
                            <SelectorBarItem x:Name="AddTab" Text="Add" Tag="Add"><SelectorBarItem.Icon><FontIcon Glyph="&#xE710;" /></SelectorBarItem.Icon></SelectorBarItem>
                            <SelectorBarItem x:Name="WorldTab" Text="World" Tag="World"><SelectorBarItem.Icon><FontIcon Glyph="&#xE909;" /></SelectorBarItem.Icon></SelectorBarItem>
                            <SelectorBarItem x:Name="ProjectTab" Text="Project" Tag="Project"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" /></SelectorBarItem.Icon></SelectorBarItem>
                            <SelectorBarItem x:Name="LiveTab" Tag="Live" ToolTipService.ToolTip="Live: collaboration session, who is in it, the chat"><SelectorBarItem.Icon><FontIcon Glyph="&#xE716;" /></SelectorBarItem.Icon></SelectorBarItem>
                        </SelectorBar>
                    </Border>

                    <!-- ===== Inspector ===== -->
                    <ScrollViewer x:Name="InspectorPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Mesh edit mode: vertices, faces, openings and UVs of the edited mesh (MainWindow.MeshEdit) -->
                            <StackPanel x:Name="MeshEditPanel" Visibility="Collapsed">
                                <local:PanelSection Header="Edit mesh">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="MeshEditTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MeshEditStats" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="10,8">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Click faces or vertices (Shift adds, Ctrl removes), drag a rectangle to take several. The right button turns the view." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• The Move, Rotate and Scale tools (2, 3, 4) move what is selected with the gizmo. Delete removes the selected faces." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Opening (C): drag a rectangle on a wall. It goes through the wall and closes its sides, ready for real windows or a door." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• V vertices, B faces, Esc or M to finish. Every change is one undo step; the game gets a copy of the mesh with your changes, its materials kept." />
                                            </StackPanel>
                                        </Border>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="MeshVertexMode" HorizontalAlignment="Stretch" Click="OnMeshVertexMode" ToolTipService.ToolTip="Pick vertices (V)">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7B8;" FontSize="12" /><TextBlock Text="Vertices" FontSize="12" /></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="MeshFaceMode" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnMeshFaceMode" ToolTipService.ToolTip="Pick faces (B)">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF158;" FontSize="12" /><TextBlock Text="Faces" FontSize="12" /></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="MeshCutMode" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnMeshCutMode" ToolTipService.ToolTip="Draw an opening on a wall (C)">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7AD;" FontSize="12" /><TextBlock Text="Opening" FontSize="12" /></StackPanel>
                                            </ToggleButton>
                                        </Grid>
                                        <TextBlock x:Name="MeshSelectionText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button HorizontalAlignment="Stretch" Click="OnMeshSelectAll" ToolTipService.ToolTip="Select every face or vertex"><TextBlock Text="All" FontSize="12" /></Button>
                                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnMeshSelectNone" ToolTipService.ToolTip="Select nothing"><TextBlock Text="None" FontSize="12" /></Button>
                                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnMeshSelectLinked" ToolTipService.ToolTip="Add the faces connected to the selection"><TextBlock Text="Linked" FontSize="12" /></Button>
                                            <Button Grid.Column="3" HorizontalAlignment="Stretch" Click="OnMeshSelectCoplanar" ToolTipService.ToolTip="Add the connected faces in the same plane (a whole wall)"><TextBlock Text="Same plane" FontSize="12" /></Button>
                                        </Grid>
                                        <TextBlock Text="Opening" FontSize="12" FontWeight="SemiBold" Margin="2,4,0,0" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Depth" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="MeshCutDepthBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="0.02" Maximum="20" SmallChange="0.1" ValueChanged="OnMeshCutDepth"
                                                       ToolTipService.ToolTip="How far the opening goes through the surface, metres (half in front, half behind)" />
                                            <TextBlock Grid.Column="2" Text="Grid" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="MeshCutGridBox" Grid.Column="3" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="5" SmallChange="0.05" ValueChanged="OnMeshCutGrid"
                                                       ToolTipService.ToolTip="The rectangle's corners snap to this grid, metres (0: free)" />
                                        </Grid>
                                        <CheckBox x:Name="MeshJambsBox" Content="Close the sides of the opening (jambs)" Click="OnMeshJambs"
                                                  ToolTipService.ToolTip="Where the wall has a thickness, faces close the opening's sides with the wall's material" />
                                        <Button Style="{StaticResource ActionRowStyle}" Click="OnMeshCutSelection" ToolTipService.ToolTip="An opening the size of the selected faces, through the surface">
                                            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7AD;" FontSize="14" /><TextBlock Text="Open the selected faces' area" /></StackPanel>
                                        </Button>
                                        <TextBlock Text="Faces" FontSize="12" FontWeight="SemiBold" Margin="2,4,0,0" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                            <Button HorizontalAlignment="Stretch" Click="OnMeshExtrude" ToolTipService.ToolTip="Push the selected faces out along their normals (a negative distance makes a recess); side faces join them">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A3;" FontSize="12" /><TextBlock Text="Extrude" FontSize="12" /></StackPanel>
                                            </Button>
                                            <NumberBox x:Name="MeshExtrudeBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="-50" Maximum="50" SmallChange="0.05"
                                                       ToolTipService.ToolTip="Extrusion distance, metres" />
                                        </Grid>
                                        <Grid ColumnSpacing="6" RowSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <Button HorizontalAlignment="Stretch" Click="OnMeshDeleteFaces" ToolTipService.ToolTip="Delete the selected faces (Delete)"><TextBlock Text="Delete" FontSize="12" /></Button>
                                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnMeshSubdivide" ToolTipService.ToolTip="Split each selected face in four, to have vertices to move"><TextBlock Text="Subdivide" FontSize="12" /></Button>
                                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnMeshFlip" ToolTipService.ToolTip="Turn the selected faces around (they show from the other side)"><TextBlock Text="Flip" FontSize="12" /></Button>
                                            <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="OnMeshSmooth" ToolTipService.ToolTip="Smooth shading over the selected faces"><TextBlock Text="Smooth" FontSize="12" /></Button>
                                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnMeshFlat" ToolTipService.ToolTip="Flat shading: each selected face lit on its own"><TextBlock Text="Flat" FontSize="12" /></Button>
                                            <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnMeshTwoSided"
                                                    ToolTipService.ToolTip="A back for the selected faces (none selected: every face), so they show from both sides: the game draws a face from its front only"><TextBlock Text="Two-sided" FontSize="12" /></Button>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="MeshPartBox" HorizontalAlignment="Stretch" ToolTipService.ToolTip="The mesh's parts and the material slot each wears" />
                                            <Button Grid.Column="1" Click="OnMeshMoveToPart" ToolTipService.ToolTip="Give the selected faces this part's material"><TextBlock Text="Use this material" FontSize="12" /></Button>
                                        </Grid>
                                        <TextBlock Text="UVs" FontSize="12" FontWeight="SemiBold" Margin="2,4,0,0" />
                                        <Border Background="#FF101114" CornerRadius="4" HorizontalAlignment="Left">
                                            <Canvas x:Name="MeshUvCanvas" Width="236" Height="236" Background="Transparent"
                                                    PointerPressed="OnMeshUvPressed" PointerMoved="OnMeshUvMoved" PointerReleased="OnMeshUvReleased"
                                                    ToolTipService.ToolTip="The selected faces' UVs (the square is one texture). Drag to move them." />
                                        </Border>
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="Offset" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="MeshUvOffsetU" Grid.Column="1" SpinButtonPlacementMode="Hidden" SmallChange="0.05" ToolTipService.ToolTip="Move the UVs along U" />
                                            <NumberBox x:Name="MeshUvOffsetV" Grid.Column="2" SpinButtonPlacementMode="Hidden" SmallChange="0.05" ToolTipService.ToolTip="Move the UVs along V" />
                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Scale" Style="{StaticResource PropLabelStyle}" />
                                                <NumberBox x:Name="MeshUvScale" Grid.Column="1" SpinButtonPlacementMode="Hidden" SmallChange="0.1" ToolTipService.ToolTip="Scale the UVs about their centre (2: the texture twice as small)" />
                                                <TextBlock Grid.Column="2" Text="Turn (°)" Style="{StaticResource PropLabelStyle}" />
                                                <NumberBox x:Name="MeshUvRotate" Grid.Column="3" SpinButtonPlacementMode="Hidden" SmallChange="5" ToolTipService.ToolTip="Turn the UVs about their centre, degrees" />
                                            </Grid>
                                            <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Click="OnMeshUvApply" ToolTipService.ToolTip="Apply the offset, scale and rotation to the selected faces' UVs"><TextBlock Text="Apply to the UVs" FontSize="12" /></Button>
                                            <Button Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnMeshUvProject" ToolTipService.ToolTip="New UVs projected flat along the selected faces (the texture at the mesh's own density, straight)"><TextBlock Text="Project" FontSize="12" /></Button>
                                        </Grid>
                                        <TextBlock Text="History" FontSize="12" FontWeight="SemiBold" Margin="2,4,0,0" />
                                        <TextBlock x:Name="MeshHistoryText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MeshLinkedText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="MeshRemoveCollisionButton" HorizontalAlignment="Stretch" Click="OnMeshRemoveCollision" ToolTipService.ToolTip="Delete the game's collision of this mesh (openings do not open it): add your own boxes after"><TextBlock Text="Remove its collision" FontSize="12" /></Button>
                                            <Button x:Name="MeshRemoveOccludersButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnMeshRemoveOccluders" ToolTipService.ToolTip="Delete the game's occluders of this mesh, so what is behind the openings shows (interiors)"><TextBlock Text="Remove its occluders" FontSize="12" /></Button>
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button HorizontalAlignment="Stretch" Click="OnMeshRevert" ToolTipService.ToolTip="Undo every change of this mesh (the copy stays; Ctrl+Z undoes this too)"><TextBlock Text="Revert all" FontSize="12" /></Button>
                                            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnMeshEditDone" ToolTipService.ToolTip="Leave the mesh edit mode (Esc, M)"><TextBlock Text="Done" FontSize="12" /></Button>
                                        </Grid>
                                    </StackPanel>
                                </local:PanelSection>
                            </StackPanel>
                            <!-- Terrain tool: brushes, their size and strength, the materials to paint -->
                            <StackPanel x:Name="TerrainPanel" Visibility="Collapsed">
                                <local:PanelSection Header="Terrain">
                                    <StackPanel Spacing="8">
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="10,8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Sculpt and paint the ground" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Hold the left mouse button on the ground: the brush works as long as you hold it. Each stroke is one undo step." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Shift+wheel or [ and ] resize the brush, Ctrl+Shift+wheel sets its strength. Hold Alt for the opposite (lower, fill holes, remove paint)." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Paint shows with the game's materials in Material shading. The export replaces the edited 128 m cells of the game's terrain and their collision." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Plants follow the ground you sculpt and leave the holes you cut; objects standing on it move with it when the stroke ends (Ctrl+Z undoes both)." />
                                            </StackPanel>
                                        </Border>
                                        <VariableSizedWrapGrid x:Name="TerrainBrushGrid" Orientation="Horizontal" ItemWidth="78" ItemHeight="58" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Size" Style="{StaticResource PropLabelStyle}" />
                                            <Slider x:Name="TerrainSizeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="0.5" ValueChanged="OnTerrainSize"
                                                    ToolTipService.ToolTip="Radius of the brush (Shift+wheel, [ and ])" />
                                            <TextBlock x:Name="TerrainSizeText" Grid.Column="2" Style="{StaticResource HintStyle}" VerticalAlignment="Center" MinWidth="52" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Strength" Style="{StaticResource PropLabelStyle}" />
                                            <Slider x:Name="TerrainStrengthSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="0.5" ValueChanged="OnTerrainStrength"
                                                    ToolTipService.ToolTip="How fast the brush works (Ctrl+Shift+wheel)" />
                                            <TextBlock x:Name="TerrainStrengthText" Grid.Column="2" Style="{StaticResource HintStyle}" VerticalAlignment="Center" MinWidth="52" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Hardness" Style="{StaticResource PropLabelStyle}" />
                                            <Slider x:Name="TerrainHardnessSlider" Grid.Column="1" Minimum="0" Maximum="95" StepFrequency="1" ValueChanged="OnTerrainHardness"
                                                    ToolTipService.ToolTip="How much of the brush works at full strength before it fades to its edge" />
                                            <TextBlock x:Name="TerrainHardnessText" Grid.Column="2" Style="{StaticResource HintStyle}" VerticalAlignment="Center" MinWidth="52" />
                                        </Grid>
                                        <Grid x:Name="TerrainFlattenRow" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Level" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="TerrainLevelBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="-500" Maximum="2000" SmallChange="0.5" ValueChanged="OnTerrainLevel"
                                                       ToolTipService.ToolTip="Height to level the ground to (game Z, metres)" />
                                            <CheckBox x:Name="TerrainLevelUnderBox" Grid.Column="2" Content="Under the stroke" IsChecked="True" Click="OnTerrainLevelUnder" MinWidth="0"
                                                      ToolTipService.ToolTip="Level to the height of the ground where the stroke starts" />
                                        </Grid>
                                        <Grid x:Name="TerrainNoiseRow" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Feature size" Style="{StaticResource PropLabelStyle}" />
                                            <Slider x:Name="TerrainNoiseSlider" Grid.Column="1" Minimum="2" Maximum="200" StepFrequency="1" ValueChanged="OnTerrainNoise"
                                                    ToolTipService.ToolTip="Size of the ridges and bumps, metres" />
                                            <Button Grid.Column="2" Content="&#xE8B1;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="OnTerrainSeed" ToolTipService.ToolTip="Another pattern of ridges" />
                                        </Grid>
                                        <TextBlock x:Name="TerrainCursorText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <CheckBox x:Name="TerrainFollowBox" Content="Objects on the ground follow it" IsChecked="True" Click="OnTerrainFollow"
                                                  ToolTipService.ToolTip="When a stroke ends, the objects standing on the ground it changed (rocks, props, decals, entities) move up or down with it, in the same undo step. Buildings wider than 40 m stay where they are." />
                                    </StackPanel>
                                </local:PanelSection>
                                <local:PanelSection x:Name="TerrainPaintSection" Header="Paint">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap" Text="The material the Paint brush lays down: the layers of the game's terrain. A layer covers those listed before it; painting one clears the ones after it." />
                                        <StackPanel x:Name="TerrainLayerList" Spacing="2" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Where" Style="{StaticResource PropLabelStyle}" />
                                            <ComboBox x:Name="TerrainSlopeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnTerrainSlope"
                                                      ToolTipService.ToolTip="Paint only where the ground is steep (cliffs, rock faces) or only where it is flat (paths, fields)" />
                                            <NumberBox x:Name="TerrainSlopeAngleBox" Grid.Column="2" Minimum="1" Maximum="89" Value="30" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="OnTerrainSlopeAngle"
                                                       ToolTipService.ToolTip="Slope limit, degrees" />
                                        </Grid>
                                        <Button x:Name="TerrainShadingButton" HorizontalAlignment="Stretch" Click="OnTerrainMaterialShading" Content="See the paint (Material shading)"
                                                ToolTipService.ToolTip="Draws the world near the camera with the game's materials" />
                                    </StackPanel>
                                </local:PanelSection>
                                <local:PanelSection Header="Edited terrain">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="TerrainEditedText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <Button x:Name="TerrainClearButton" HorizontalAlignment="Stretch" Click="OnTerrainClear" Content="Undo every terrain edit"
                                                ToolTipService.ToolTip="Brings back the game's terrain everywhere (one undo step: Ctrl+Z restores the edits)" />
                                    </StackPanel>
                                </local:PanelSection>
                            </StackPanel>
                            <!-- Traffic tool: display, drawing, the selected lane -->
                            <StackPanel x:Name="TrafficPanel" Visibility="Collapsed">
                                <local:PanelSection Header="Traffic paths">
                                    <StackPanel Spacing="8">
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="10,8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Everything with the mouse" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Drag a lane's cyan end onto another lane: linked. Onto the ground: a new lane continues it." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Drag the magenta start onto the lane that should lead into it." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Drag points to reshape: they keep their height (Ctrl: follow the ground, Shift: up and down). A selected point also has the gizmo, one axis at a time. Drag the selected lane to move it. Double-click adds a point." />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="• Alt+click a point or a link deletes it. Ctrl+Z undoes any step." />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TrafficStats" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Shown within" Style="{StaticResource PropLabelStyle}" />
                                            <Slider x:Name="TrafficRangeSlider" Grid.Column="1" Minimum="20" Maximum="1000" StepFrequency="10" ValueChanged="OnTrafficRange"
                                                    ToolTipService.ToolTip="Only the lanes this close to the camera are drawn and pickable: lower it if the editor slows down" />
                                            <TextBlock x:Name="TrafficRangeText" Grid.Column="2" Style="{StaticResource HintStyle}" VerticalAlignment="Center" MinWidth="46" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="94,0,0,0">
                                            <CheckBox x:Name="TrafficRoadsBox" Content="Roads" IsChecked="True" Click="OnTrafficFilter" MinWidth="0" />
                                            <CheckBox x:Name="TrafficPavementsBox" Content="Pavements" IsChecked="True" Click="OnTrafficFilter" MinWidth="0" />
                                            <CheckBox x:Name="TrafficDisabledBox" Content="Disabled" IsChecked="True" Click="OnTrafficFilter" MinWidth="0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="94,0,0,0">
                                            <CheckBox x:Name="TrafficLinksBox" Content="Every link" IsChecked="True" Click="OnTrafficFilter" MinWidth="0"
                                                      ToolTipService.ToolTip="Amber curves where traffic goes from one lane to the next (off: only the selected lane's links)" />
                                            <CheckBox x:Name="TrafficDeadEndsBox" Content="Dead ends" Click="OnTrafficFilter" MinWidth="0"
                                                      ToolTipService.ToolTip="A red bar where a lane leads nowhere (your own lanes always show it)" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                                   Text="Green road · yellow intersection · teal highway · blue pavement · violet pavement crossing · white crosswalk · red disabled · orange line: changed in this project. Chevrons show the direction of travel." />
                                    </StackPanel>
                                </local:PanelSection>
                                <local:PanelSection Header="Draw a lane">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Kind" Style="{StaticResource PropLabelStyle}" />
                                            <ComboBox x:Name="TrafficKindBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnTrafficKind">
                                                <x:String>Road</x:String>
                                                <x:String>Road intersection</x:String>
                                                <x:String>Highway</x:String>
                                                <x:String>Pavement</x:String>
                                                <x:String>Crosswalk</x:String>
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Width / speed" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="TrafficDrawWidthBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="0.2" Maximum="40" Value="3.5" SmallChange="0.5" ToolTipService.ToolTip="Lane width (m)" ValueChanged="OnTrafficDrawSettings" />
                                            <NumberBox x:Name="TrafficDrawSpeedBox" Grid.Column="2" SpinButtonPlacementMode="Hidden" Minimum="1" Maximum="60" Value="15" SmallChange="1" ToolTipService.ToolTip="Speed limit (m/s: 10 ≈ 36 km/h, 15 ≈ 54, 17 ≈ 61; pavements 1)" ValueChanged="OnTrafficDrawSettings" />
                                        </Grid>
                                        <CheckBox x:Name="TrafficDrawBothBox" Content="Both directions (two lanes)" Click="OnTrafficDrawSettings2" Margin="94,0,0,0" />
                                        <CheckBox x:Name="TrafficDrawLinkBox" Content="Link to the lanes its ends meet" IsChecked="True" Click="OnTrafficDrawSettings2" Margin="94,0,0,0" />
                                        <Button x:Name="TrafficDrawButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnTrafficDraw"
                                                ToolTipService.ToolTip="Click points on the ground in the direction of travel, Enter finishes, Backspace removes the last point, Esc cancels">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock x:Name="TrafficDrawText" Text="Draw a lane" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </local:PanelSection>
                                <local:PanelSection x:Name="TrafficLaneSection" Header="Selected lane">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="TrafficLaneTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TrafficLaneInfo" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Width / speed" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="TrafficLaneWidthBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="0.2" Maximum="40" SmallChange="0.5" ToolTipService.ToolTip="Lane width (m)" ValueChanged="OnTrafficLaneNumber" />
                                            <NumberBox x:Name="TrafficLaneSpeedBox" Grid.Column="2" SpinButtonPlacementMode="Hidden" Minimum="1" Maximum="255" SmallChange="1" ToolTipService.ToolTip="Speed limit (m/s)" ValueChanged="OnTrafficLaneNumber" />
                                        </Grid>
                                        <TextBlock Text="Flags" Style="{StaticResource PropLabelStyle}" />
                                        <VariableSizedWrapGrid x:Name="TrafficFlagsGrid" Orientation="Horizontal" ItemWidth="124" />
                                        <CheckBox x:Name="TrafficBothWaysBox" Content="Change the reverse direction too" IsChecked="True" />
                                        <TextBlock Text="Leads to" Style="{StaticResource PropLabelStyle}" />
                                        <StackPanel x:Name="TrafficOutList" Spacing="2" />
                                        <TextBlock Text="Comes from" Style="{StaticResource PropLabelStyle}" />
                                        <StackPanel x:Name="TrafficInList" Spacing="2" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button Content="Link to a lane…" HorizontalAlignment="Stretch" Click="OnTrafficLinkOut" ToolTipService.ToolTip="Then click the lane this one should lead into (where it joins it)" />
                                            <Button Grid.Column="1" Content="Link from a lane…" HorizontalAlignment="Stretch" Click="OnTrafficLinkIn" ToolTipService.ToolTip="Then click a lane that should lead into this one" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button Content="Auto-link its ends" HorizontalAlignment="Stretch" Click="OnTrafficAutoLink" ToolTipService.ToolTip="Links it to the lanes of its kind that start or end within 3 m of its ends" />
                                            <Button x:Name="TrafficReverseButton" Grid.Column="1" Content="Reverse it" HorizontalAlignment="Stretch" Click="OnTrafficReverse" ToolTipService.ToolTip="A lane drawn in this project, the other way round (relinked at its ends)" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button Content="Insert point" HorizontalAlignment="Stretch" Click="OnTrafficInsertPoint" ToolTipService.ToolTip="After the selected point (or double-click on the lane where you want one)" />
                                            <Button Grid.Column="1" Content="Delete point" HorizontalAlignment="Stretch" Click="OnTrafficDeletePoint" ToolTipService.ToolTip="The selected point (Del)" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button x:Name="TrafficTwinButton" Content="Other direction" HorizontalAlignment="Stretch" Click="OnTrafficTwin" ToolTipService.ToolTip="Select the lane going the other way" />
                                            <Button x:Name="TrafficRevertButton" Grid.Column="1" Content="Revert to game" HorizontalAlignment="Stretch" Click="OnTrafficRevert" ToolTipService.ToolTip="Drop this project's changes to the lane" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button Content="Delete lane" HorizontalAlignment="Stretch" Click="OnTrafficDeleteLane" ToolTipService.ToolTip="A game lane is disabled and unlinked (the game keeps its slot); a drawn lane goes" />
                                            <Button x:Name="TrafficDeleteBothButton" Grid.Column="1" Content="Delete both ways" HorizontalAlignment="Stretch" Click="OnTrafficDeleteBoth" />
                                        </Grid>
                                    </StackPanel>
                                </local:PanelSection>
                            </StackPanel>
                            <StackPanel x:Name="InspectorEmpty" Padding="28,36,28,20" Spacing="8">
                                <FontIcon Glyph="&#xE7C9;" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Text="Nothing selected" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource HintStyle}" TextAlignment="Center"
                                           Text="Click an object in the world or in the outliner to edit it here: transform, light, door, collision, road…" />
                                <Button Content="Add something…" HorizontalAlignment="Center" Margin="0,6,0,0" Click="OnShowAddTab" />
                            </StackPanel>

                            <StackPanel x:Name="InspectorContent" Visibility="Collapsed">
                                <!-- Identity -->
                                <Grid Padding="12,12,8,10" ColumnSpacing="10" Background="{StaticResource PaneHeaderBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="InspectorGlyphTile" Width="38" Height="38" CornerRadius="4" Background="{StaticResource TileBackgroundBrush}" VerticalAlignment="Top">
                                        <FontIcon x:Name="InspectorGlyph" Glyph="&#xE7B8;" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBox x:Name="InspectorNameBox" FontSize="14" FontWeight="SemiBold" Padding="6,3,6,3" MinHeight="0" Background="Transparent" BorderThickness="0"
                                                 KeyDown="OnInspectorNameKey" LostFocus="OnInspectorNameCommit" ToolTipService.ToolTip="Rename (F2 in the outliner)" />
                                        <TextBlock x:Name="InspectorType" Style="{StaticResource HintStyle}" Margin="6,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="InspectorColorButton" Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Colour tag">
                                            <Ellipse x:Name="InspectorColorDot" Width="12" Height="12" Stroke="{StaticResource StrongHairlineBrush}" StrokeThickness="1" Fill="Transparent" />
                                            <Button.Flyout>
                                                <Flyout x:Name="InspectorColorFlyout" Placement="BottomEdgeAlignedRight">
                                                    <StackPanel x:Name="InspectorColorPalette" Orientation="Horizontal" Spacing="4" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Style="{StaticResource PaneIconButtonStyle}" Content="&#xE71E;" Click="OnFrameSelection" ToolTipService.ToolTip="Focus (F)" />
                                        <Button Style="{StaticResource PaneIconButtonStyle}" Content="&#xE711;" Click="OnDeselect" ToolTipService.ToolTip="Deselect (Esc)" />
                                    </StackPanel>
                                </Grid>
                                <Grid Padding="12,6,12,6" ColumnSpacing="8" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Folder" Style="{StaticResource PropLabelStyle}" />
                                    <DropDownButton x:Name="InspectorFolderButton" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,3" CornerRadius="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon x:Name="InspectorFolderGlyph" Glyph="&#xE8B7;" FontSize="12" />
                                            <TextBlock x:Name="InspectorFolderText" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout x:Name="InspectorFolderMenu" Placement="BottomEdgeAlignedLeft" Opening="OnInspectorFolderMenuOpening" />
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </Grid>
                                <Border x:Name="InspectorWarning" Background="{StaticResource DangerSoftBrush}" Margin="12,10,12,0" Padding="10,7" CornerRadius="3" Visibility="Collapsed">
                                    <TextBlock x:Name="InspectorWarningText" FontSize="12" TextWrapping="Wrap" />
                                </Border>

                                <!-- An elevator cabin placed as a plain entity: it does not work on its own -->
                                <Border x:Name="ElevatorConvertBar" Background="{StaticResource AccentSoftBrush}" Margin="12,10,12,0" Padding="10,8" CornerRadius="4" Visibility="Collapsed">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="ElevatorConvertText" FontSize="12" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource AccentButtonStyle}" Click="OnConvertToElevator" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8CB;" FontSize="13" /><TextBlock Text="Make it a working elevator" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Transform -->
                                <local:PanelSection x:Name="TransformSection" Header="Transform">
                                    <StackPanel x:Name="TransformEditor" Spacing="6">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Position" Style="{StaticResource PropLabelStyle}" />
                                            <Grid Grid.Column="1"><NumberBox x:Name="PosX" SpinButtonPlacementMode="Hidden" SmallChange="0.1" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="X (m, east)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisXBrush}" /></Grid>
                                            <Grid Grid.Column="2"><NumberBox x:Name="PosY" SpinButtonPlacementMode="Hidden" SmallChange="0.1" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Y (m, north)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisYBrush}" /></Grid>
                                            <Grid Grid.Column="3"><NumberBox x:Name="PosZ" SpinButtonPlacementMode="Hidden" SmallChange="0.1" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Z (m, up)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisZBrush}" /></Grid>
                                        </Grid>
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Rotation" Style="{StaticResource PropLabelStyle}" />
                                            <Grid Grid.Column="1"><NumberBox x:Name="RotYaw" SpinButtonPlacementMode="Hidden" SmallChange="1" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Yaw (°, about Z)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisZBrush}" /></Grid>
                                            <Grid Grid.Column="2"><NumberBox x:Name="RotPitch" SpinButtonPlacementMode="Hidden" SmallChange="1" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Pitch (°, about X)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisXBrush}" /></Grid>
                                            <Grid Grid.Column="3"><NumberBox x:Name="RotRoll" SpinButtonPlacementMode="Hidden" SmallChange="1" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Roll (°, about Y)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisYBrush}" /></Grid>
                                        </Grid>
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Scale" Style="{StaticResource PropLabelStyle}" />
                                            <Grid Grid.Column="1"><NumberBox x:Name="ScaleX" SpinButtonPlacementMode="Hidden" SmallChange="0.05" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Scale X" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisXBrush}" /></Grid>
                                            <Grid Grid.Column="2"><NumberBox x:Name="ScaleY" SpinButtonPlacementMode="Hidden" SmallChange="0.05" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Scale Y" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisYBrush}" /></Grid>
                                            <Grid Grid.Column="3"><NumberBox x:Name="ScaleZ" SpinButtonPlacementMode="Hidden" SmallChange="0.05" ValueChanged="OnTransformEdited" ToolTipService.ToolTip="Scale Z" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisZBrush}" /></Grid>
                                        </Grid>
                                        <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button Click="OnDropToGround" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Drop to ground (End)">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74B;" FontSize="12" /><TextBlock Text="Drop" FontSize="12" /></StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Click="OnResetTransform" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Back to the original transform">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Reset" FontSize="12" /></StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Click="OnDuplicate" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Duplicate (Ctrl+D)">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="12" /><TextBlock Text="Duplicate" FontSize="12" /></StackPanel>
                                            </Button>
                                        </Grid>
                                        <Button Click="OnMeshEditToggle" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Edit this mesh in place: openings for windows and doors, vertices, faces, UVs (M)">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="12" /><TextBlock Text="Edit mesh" FontSize="12" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Arrange: align, distribute, duplicate in series -->
                                <local:PanelSection x:Name="ArrangeSection" Header="Arrange" Key="InspectorArrange">
                                    <StackPanel Spacing="10">
                                        <StackPanel x:Name="AlignPanel" Spacing="4">
                                            <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap" Text="Line the others up with the last selected; spread three or more evenly." />
                                            <Grid x:Name="AlignGrid" ColumnSpacing="4" RowSpacing="4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Duplicate in series" FontSize="12" FontWeight="SemiBold" />
                                            <Grid ColumnSpacing="4" RowSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                <TextBlock Text="Offset" Style="{StaticResource PropLabelStyle}" />
                                                <Grid Grid.Column="1"><NumberBox x:Name="SeriesX" SpinButtonPlacementMode="Hidden" SmallChange="0.1" Value="1" ToolTipService.ToolTip="Each copy moves this far east (m) from the previous" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisXBrush}" /></Grid>
                                                <Grid Grid.Column="2"><NumberBox x:Name="SeriesY" SpinButtonPlacementMode="Hidden" SmallChange="0.1" Value="0" ToolTipService.ToolTip="North (m)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisYBrush}" /></Grid>
                                                <Grid Grid.Column="3"><NumberBox x:Name="SeriesZ" SpinButtonPlacementMode="Hidden" SmallChange="0.1" Value="0" ToolTipService.ToolTip="Up (m)" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisZBrush}" /></Grid>
                                                <TextBlock Grid.Row="1" Text="Copies" Style="{StaticResource PropLabelStyle}" />
                                                <NumberBox x:Name="SeriesCount" Grid.Row="1" Grid.Column="1" SpinButtonPlacementMode="Compact" Minimum="1" Maximum="500" Value="3" ToolTipService.ToolTip="How many copies" />
                                                <NumberBox x:Name="SeriesTurn" Grid.Row="1" Grid.Column="2" SpinButtonPlacementMode="Hidden" SmallChange="5" Value="0" ToolTipService.ToolTip="Each copy turns this many degrees (about Z, around the selection) from the previous" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="° turn" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Button Click="OnSeriesFit" ToolTipService.ToolTip="Offset = the selection's width along X (copies touch)">
                                                    <FontIcon Glyph="&#xE9A6;" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="1" Click="OnSeries" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF0E2;" FontSize="12" /><TextBlock x:Name="SeriesButtonText" Text="Make 3 copies" FontSize="12" /></StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Streaming: how far away the game loads a project mesh (MainWindow.Streaming.cs) -->
                                <local:PanelSection x:Name="StreamingSection" Header="Streaming" Key="InspectorStreaming" Visibility="Collapsed">
                                    <StackPanel x:Name="StreamingPanel" Spacing="6" />
                                </local:PanelSection>

                                <!-- Light -->
                                <local:PanelSection x:Name="LightSection" Header="Light">
                                    <StackPanel x:Name="LightEditor" Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Type" Style="{StaticResource PropLabelStyle}" />
                                            <ComboBox x:Name="LightTypeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnLightTypeChanged">
                                                <x:String>Point</x:String>
                                                <x:String>Spot</x:String>
                                                <x:String>Area</x:String>
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Colour · Kelvin" Style="{StaticResource PropLabelStyle}" />
                                            <Button x:Name="LightColorButton" Grid.Column="1" Width="56" Height="28" Padding="3" CornerRadius="3" ToolTipService.ToolTip="Light colour (used when the temperature is 0)">
                                                <Border x:Name="LightColorSwatch" CornerRadius="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                <Button.Flyout>
                                                    <Flyout Closed="OnLightColorClosed">
                                                        <ColorPicker x:Name="LightColorPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False" IsColorSliderVisible="True" IsHexInputVisible="True" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <NumberBox x:Name="LightTemperatureBox" Grid.Column="2" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="40000" SmallChange="100" LargeChange="500"
                                                       ValueChanged="OnElementNumberChanged" Header="" PlaceholderText="Kelvin" ToolTipService.ToolTip="Temperature in Kelvin (2700 warm … 6500 white); 0 uses the colour" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Intensity (lm)" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="LightIntensityBox" Grid.Column="1" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="1000000" SmallChange="10" LargeChange="100" ValueChanged="OnElementNumberChanged" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Radius (m)" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="LightRadiusBox" Grid.Column="1" SpinButtonPlacementMode="Compact" Minimum="0.05" Maximum="1000" SmallChange="0.5" LargeChange="5" ValueChanged="OnElementNumberChanged" />
                                        </Grid>
                                        <Grid x:Name="SpotAngles" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Cone (°)" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="LightInnerBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="179" SmallChange="1" LargeChange="10" ValueChanged="OnElementNumberChanged" PlaceholderText="Inner" ToolTipService.ToolTip="Inner angle" />
                                            <NumberBox x:Name="LightOuterBox" Grid.Column="2" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="179" SmallChange="1" LargeChange="10" ValueChanged="OnElementNumberChanged" PlaceholderText="Outer" ToolTipService.ToolTip="Outer angle" />
                                        </Grid>
                                        <CheckBox x:Name="LightShadowsBox" Content="Casts shadows" Click="OnElementPropertyChanged" Margin="94,0,0,0" />
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Door or entity -->
                                <local:PanelSection x:Name="DoorSection" Header="Door">
                                    <StackPanel x:Name="DoorEditor" Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Look" Style="{StaticResource PropLabelStyle}" />
                                            <ComboBox x:Name="DoorAppearanceBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnDoorAppearanceChanged" />
                                        </Grid>
                                        <TextBlock x:Name="DoorDecorativeNote" Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                                   Text="Decorative door: it never opens (its interaction only says it is locked). Choose an interactive door in Add ▸ Doors to make it work." />
                                        <StackPanel x:Name="DoorBehaviour" Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Opens by" Style="{StaticResource PropLabelStyle}" />
                                                <ComboBox x:Name="DoorTypeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnDoorChanged" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Starts" Style="{StaticResource PropLabelStyle}" />
                                                <ComboBox x:Name="DoorStateBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnDoorChanged" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Movement" Style="{StaticResource PropLabelStyle}" />
                                                <ComboBox x:Name="DoorOpeningBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnDoorChanged" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Close / speed" Style="{StaticResource PropLabelStyle}" />
                                                <NumberBox x:Name="DoorDelayBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="600" SmallChange="0.5" LargeChange="5" ValueChanged="OnDoorNumberChanged" ToolTipService.ToolTip="Closes after (s)" />
                                                <NumberBox x:Name="DoorSpeedBox" Grid.Column="2" SpinButtonPlacementMode="Hidden" Minimum="0.1" Maximum="20" SmallChange="0.1" LargeChange="1" ValueChanged="OnDoorNumberChanged" ToolTipService.ToolTip="Opening speed" />
                                            </Grid>
                                            <CheckBox x:Name="DoorAutoCloseBox" Content="Closes automatically" Click="OnDoorClick" Margin="94,0,0,0" />
                                            <CheckBox x:Name="DoorToggleLockBox" Content="Player can lock and unlock it" Click="OnDoorClick" Margin="94,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Resource of an effect, decal, door or entity -->
                                <local:PanelSection x:Name="ResourceSection" Header="Resource">
                                    <StackPanel x:Name="ResourceEditor" Spacing="6">
                                        <TextBox x:Name="ElementResourceBox" FontFamily="{StaticResource MonoFont}" FontSize="11" KeyDown="OnElementResourceKey" ToolTipService.ToolTip="Type a path and press Enter" />
                                        <TextBlock x:Name="ElementResourceNote" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <Button x:Name="UseListedResourceButton" Content="Use the one chosen in Add" Click="OnUseListedResource" HorizontalAlignment="Stretch" />
                                        <!-- Particle systems and effects: what the view plays of them. -->
                                        <Grid x:Name="EffectPlayRow" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="EffectPlayInfo" Style="{StaticResource HintStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Height="32" Click="OnEffectRestart" ToolTipService.ToolTip="Play it again from its start">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Decal -->
                                <local:PanelSection x:Name="DecalSection" Header="Decal">
                                    <StackPanel x:Name="DecalEditor" Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Opacity / tint" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="DecalAlphaBox" Grid.Column="1" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnElementNumberChanged" />
                                            <Button x:Name="DecalColorButton" Grid.Column="2" Width="56" Height="28" Padding="3" CornerRadius="3">
                                                <Border x:Name="DecalColorSwatch" CornerRadius="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                <Button.Flyout>
                                                    <Flyout Closed="OnDecalColorClosed">
                                                        <ColorPicker x:Name="DecalColorPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False" IsHexInputVisible="True" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <TextBlock Style="{StaticResource HintStyle}" Text="Its size is the scale: X × Y metres, Z the projection depth." />
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Sound -->
                                <local:PanelSection x:Name="SoundSection" Header="Sound">
                                    <StackPanel Spacing="8">
                                        <Grid x:Name="SoundEditor" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Radius (m)" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="SoundRadiusBox" Grid.Column="1" SpinButtonPlacementMode="Compact" Minimum="0.05" Maximum="1000" SmallChange="0.5" LargeChange="5" ValueChanged="OnElementNumberChanged" />
                                        </Grid>
                                        <!-- The game event the emitter plays, to listen to. -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Plays" Style="{StaticResource PropLabelStyle}" />
                                            <TextBlock x:Name="SoundEventName" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
                                            <Button x:Name="SoundEventPlayButton" Grid.Column="2" Height="32" Click="OnSoundEventPlay" ToolTipService.ToolTip="Listen to what this emitter plays in game">
                                                <FontIcon x:Name="SoundEventPlayIcon" Glyph="&#xE768;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="SoundEventDetail" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="94,-4,0,0" />
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Custom sound (Open77) -->
                                <local:PanelSection x:Name="CustomSoundSection" Header="Custom sound (Open77)">
                                    <StackPanel x:Name="CustomSoundEditor" Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Sound" Style="{StaticResource PropLabelStyle}" />
                                            <ComboBox x:Name="CustomSoundBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnCustomSoundChosen" />
                                            <Button x:Name="CustomSoundPlayButton" Grid.Column="2" Height="32" Click="OnCustomSoundPlay" ToolTipService.ToolTip="Listen (once, at full volume)">
                                                <FontIcon x:Name="CustomSoundPlayIcon" Glyph="&#xE768;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="CustomSoundDetail" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="94,-4,0,0" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Volume (%)" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="CustomSoundVolumeBox" Grid.Column="1" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100" SmallChange="5" LargeChange="20" ValueChanged="OnCustomSoundNumber" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Distance (m)" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="CustomSoundNearBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="999" SmallChange="0.5" LargeChange="5" ValueChanged="OnCustomSoundNumber" PlaceholderText="Full" ToolTipService.ToolTip="Full volume within this distance" />
                                            <NumberBox x:Name="CustomSoundFarBox" Grid.Column="2" SpinButtonPlacementMode="Hidden" Minimum="0.1" Maximum="1000" SmallChange="1" LargeChange="10" ValueChanged="OnCustomSoundNumber" PlaceholderText="Silent" ToolTipService.ToolTip="Fades linearly to silence at this distance" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Plays" Style="{StaticResource PropLabelStyle}" />
                                            <ComboBox x:Name="CustomSoundPlaybackBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnCustomSoundPlayback">
                                                <x:String>In a loop</x:String>
                                                <x:String>Again after a pause</x:String>
                                            </ComboBox>
                                        </Grid>
                                        <Grid x:Name="CustomSoundPauseRow" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Pause (s)" Style="{StaticResource PropLabelStyle}" />
                                            <NumberBox x:Name="CustomSoundPauseMinBox" Grid.Column="1" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="3600" SmallChange="1" LargeChange="10" ValueChanged="OnCustomSoundNumber" PlaceholderText="From" ToolTipService.ToolTip="Shortest pause between two plays" />
                                            <NumberBox x:Name="CustomSoundPauseMaxBox" Grid.Column="2" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="3600" SmallChange="1" LargeChange="10" ValueChanged="OnCustomSoundNumber" PlaceholderText="To" ToolTipService.ToolTip="Longest pause (a random one in between each time)" />
                                        </Grid>
                                        <CheckBox x:Name="CustomSoundSyncedBox" Content="Synced between players" Click="OnCustomSoundSynced" Margin="94,0,0,0"
                                                  ToolTipService.ToolTip="The server plays the loop: every player hears the same moment (music). 16 synced sounds at most per world; the others start near each player." />
                                        <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                                   Text="Open77 only: written by File ▸ Export for Open77, never in ArchiveXL mods. Fades linearly to silence, no occlusion by walls. World ▸ Hear custom sounds plays them around the camera." />
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Collision and occlusion -->
                                <local:PanelSection x:Name="CollisionSection" Header="Collision">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="CollisionSelectionHeader" Style="{StaticResource HintStyle}" />
                                        <StackPanel x:Name="CollisionInspector" Spacing="8" />
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Road -->
                                <local:PanelSection x:Name="RoadSection" Header="Road">
                                    <StackPanel Spacing="8">
                                        <StackPanel x:Name="RoadVanillaPanel" Spacing="8" Visibility="Collapsed">
                                            <TextBlock x:Name="RoadVanillaText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnRebuildRoad" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="14" /><TextBlock x:Name="RoadVanillaButtonText" Text="Edit this road" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="RoadDetails" Spacing="8" Visibility="Collapsed">
                                            <TextBlock x:Name="RoadSummary" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" />
                                            <Border x:Name="RoadProfileBox" Height="84" CornerRadius="4" Background="{StaticResource AccentSoftBrush}" Padding="6,4"
                                                    ToolTipService.ToolTip="The road's profile (blue, red where steep) over the ground under it (brown): fill where the road is above it, cut where below">
                                                <Canvas x:Name="RoadProfileCanvas" />
                                            </Border>
                                            <Grid x:Name="RoadBankingRow" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Banking (°)" Style="{StaticResource PropLabelStyle}" />
                                                <NumberBox x:Name="RoadBankingBox" Grid.Column="1" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="5" Minimum="-45" Maximum="45" ValueChanged="OnRoadBanking"
                                                           ToolTipService.ToolTip="+ raises the right edge" />
                                            </Grid>
                                            <CheckBox x:Name="RoadGroundBox" Content="Shape the terrain under the road" Click="OnRoadGround"
                                                      ToolTipService.ToolTip="The ground goes just under the road, with banks back to it on each side (fill where the road is above it, cut where below), and follows the road as you edit it" />
                                            <Grid x:Name="RoadGroundRow" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Banks" Style="{StaticResource PropLabelStyle}" />
                                                <NumberBox x:Name="RoadSlopeBox" Grid.Column="1" SpinButtonPlacementMode="Compact" Minimum="10" Maximum="80" SmallChange="5" ValueChanged="OnRoadGroundValue"
                                                           ToolTipService.ToolTip="Slope of the banks, degrees (20: gentle, 45: steep)" />
                                                <NumberBox x:Name="RoadMarginBox" Grid.Column="2" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="30" SmallChange="0.5" ValueChanged="OnRoadGroundValue"
                                                           ToolTipService.ToolTip="Flat ground on each side of the road before the banks, metres" />
                                            </Grid>
                                            <CheckBox x:Name="RoadPlantsBox" Content="Clear the plants on the road" Click="OnRoadPlants"
                                                      ToolTipService.ToolTip="The game's bushes and trees on the road and its edges go" />
                                            <Button x:Name="RoadJoinGameButton" Content="Rebuild the game roads it meets" Click="OnRoadJoinGame" HorizontalAlignment="Stretch" FontSize="12" Visibility="Collapsed"
                                                    ToolTipService.ToolTip="Its junctions are laid over game roads, which stay whole under them (their sidewalks too). Rebuilt as project roads of the closest textured type, the game roads are cut at the junctions like yours: curb returns and sidewalk corners on every side" />
                                            <CheckBox x:Name="RoadOverpassBox" Content="Bridge or overpass: no junctions" Click="OnRoadOverpass"
                                                      ToolTipService.ToolTip="Where roads cross or one ends on another at the same height, they stop at a junction laid between them. A bridge or an overpass crosses the others without one: they stay whole under it" />
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="RoadPointHeader" Text="Point" Style="{StaticResource PropLabelStyle}" />
                                                <Grid Grid.Column="1"><NumberBox x:Name="RoadPointX" SpinButtonPlacementMode="Hidden" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisXBrush}" /></Grid>
                                                <Grid Grid.Column="2"><NumberBox x:Name="RoadPointY" SpinButtonPlacementMode="Hidden" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisYBrush}" /></Grid>
                                                <Grid Grid.Column="3"><NumberBox x:Name="RoadPointZ" SpinButtonPlacementMode="Hidden" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisZBrush}" /></Grid>
                                                <Button Grid.Column="4" Style="{StaticResource PaneIconButtonStyle}" Content="&#xE73E;" Click="OnRoadPointApply" ToolTipService.ToolTip="Move the point" />
                                            </Grid>
                                            <Grid ColumnSpacing="6" RowSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                <ToggleButton x:Name="RoadDrawToggle" Content="Add points" Click="OnRoadDrawToggle" HorizontalAlignment="Stretch" FontSize="12" ToolTipService.ToolTip="Click on the ground to extend the road from its selected end" />
                                                <Button Grid.Column="1" Content="Insert" Click="OnRoadInsertPoint" HorizontalAlignment="Stretch" FontSize="12" ToolTipService.ToolTip="Insert a point on the curve after the selected one" />
                                                <Button Grid.Column="2" Content="Delete point" Click="OnRoadDeletePoint" HorizontalAlignment="Stretch" FontSize="12" />
                                                <Button Grid.Row="1" Content="Reverse" Click="OnRoadReverse" HorizontalAlignment="Stretch" FontSize="12" />
                                                <Button Grid.Row="1" Grid.Column="1" Content="Snap" Click="OnRoadSnap" HorizontalAlignment="Stretch" FontSize="12" ToolTipService.ToolTip="Snap the road to the ground" />
                                                <Button Grid.Row="1" Grid.Column="2" Click="OnRoadDelete" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="12" /><TextBlock Text="Road" FontSize="12" /></StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Button Content="Smooth profile" Click="OnRoadSmooth" HorizontalAlignment="Stretch" FontSize="12"
                                                        ToolTipService.ToolTip="Evens out the road's heights between its ends: bumps and dips go" />
                                                <Button Grid.Column="1" Content="Even grade" Click="OnRoadEvenGrade" HorizontalAlignment="Stretch" FontSize="12"
                                                        ToolTipService.ToolTip="One steady slope from the first point's height to the last one's" />
                                            </Grid>
                                            <Button x:Name="RoadTrafficButton" Click="OnRoadTrafficLanes" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Lanes vehicles follow along this road, driving on the right, linked to the game's lanes at its ends">
                                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE819;" FontSize="13" /><TextBlock Text="Traffic lanes…" /></StackPanel>
                                            </Button>
                                            <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                                       Text="Drag a handle over the ground (Ctrl keeps its height; the gizmo moves it up and down) · Click or drag the curve to add a point there · Add points continues from the selected end · Del removes the point." />
                                        </StackPanel>
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- Elevator: type, look, floors (built in MainWindow.Elevators) -->
                                <local:PanelSection x:Name="ElevatorSection" Header="Elevator">
                                    <StackPanel x:Name="ElevatorInspector" Spacing="10" />
                                </local:PanelSection>

                                <!-- Details -->
                                <local:PanelSection x:Name="InfoSection" Header="Details">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="ElementInfo" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InspectorMesh" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </local:PanelSection>

                                <!-- The selected mesh's material slots, one row each with its picker (MainWindow.MaterialSlots.cs) -->
                                <local:PanelSection x:Name="MaterialsSection" Header="Materials" Key="Materials" Visibility="Collapsed">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="MaterialsHint" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <StackPanel x:Name="MaterialTiles" Spacing="4" />
                                    </StackPanel>
                                </local:PanelSection>

                                <Grid Padding="12,10,12,16">
                                    <Button Click="OnDelete" HorizontalAlignment="Stretch" Background="{StaticResource DangerSoftBrush}" BorderThickness="0" CornerRadius="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock x:Name="DeleteButtonText" Text="Delete" /></StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Collision and Occlusion layers: what is drawn, adding shapes, colours (as filters) -->
                            <StackPanel x:Name="LayerPanel" Visibility="Collapsed">
                                <local:PanelSection x:Name="LayerSection" Header="Collision layer" Key="LayerView">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="LayerHint" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Shown within" Style="{StaticResource PropLabelStyle}" />
                                            <Slider x:Name="LayerRangeSlider" Grid.Column="1" Minimum="5" Maximum="200" StepFrequency="5" ValueChanged="OnLayerRange"
                                                    ToolTipService.ToolTip="Only what is this close to the camera is drawn and pickable: lower it to clear the view" />
                                            <TextBlock x:Name="LayerRangeText" Grid.Column="2" Style="{StaticResource ValueStyle}" VerticalAlignment="Center" Width="44" />
                                        </Grid>
                                        <Grid x:Name="OccluderSizeRow" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Hide larger" Style="{StaticResource PropLabelStyle}" />
                                            <Slider x:Name="OccluderSizeSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5" ValueChanged="OnOccluderSize"
                                                    ToolTipService.ToolTip="Occluders bigger than this (their largest side) are not drawn nor picked: building-sized boxes hide the small ones" />
                                            <TextBlock x:Name="OccluderSizeText" Grid.Column="2" Style="{StaticResource ValueStyle}" VerticalAlignment="Center" Width="44" />
                                        </Grid>
                                        <StackPanel x:Name="CollisionSourceRow" Orientation="Horizontal" Spacing="10" Margin="94,0,0,0">
                                            <CheckBox x:Name="LayerGameBox" Content="Game" IsChecked="True" Click="OnLayerDisplay" MinWidth="0" ToolTipService.ToolTip="The game's own collision" />
                                            <CheckBox x:Name="LayerProjectBox" Content="Project" IsChecked="True" Click="OnLayerDisplay" MinWidth="0" ToolTipService.ToolTip="Collision added or made editable in this project" />
                                        </StackPanel>
                                        <CheckBox x:Name="LayerXrayBox" Content="Outlines through walls" Click="OnLayerDisplay"
                                                  ToolTipService.ToolTip="Faint outlines of what walls hide (shapes inside walls and buildings); off: only what is in view" />
                                        <CheckBox x:Name="LayerFadeBox" Content="Fade the rest while something is selected" IsChecked="True" Click="OnLayerDisplay" />
                                        <CheckBox x:Name="LayerDimBox" Content="Darken the world" IsChecked="True" Click="OnLayerDisplay" ToolTipService.ToolTip="The scene is darkened under the shapes so they stand out" />
                                        <TextBlock x:Name="LayerStats" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </local:PanelSection>
                                <local:PanelSection x:Name="LayerAddSection" Header="Add" Key="LayerAdd">
                                    <StackPanel Spacing="6">
                                        <Grid x:Name="LayerAddCollision" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button HorizontalAlignment="Stretch" Click="OnAddCollision" Tag="Box" ToolTipService.ToolTip="A box collision on the surface at the centre of the view"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF158;" FontSize="13" /><TextBlock Text="Box" /></StackPanel></Button>
                                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnAddCollision" Tag="Sphere"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEA3A;" FontSize="13" /><TextBlock Text="Sphere" /></StackPanel></Button>
                                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnAddCollision" Tag="Capsule"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE91F;" FontSize="13" /><TextBlock Text="Capsule" /></StackPanel></Button>
                                        </Grid>
                                        <Button x:Name="LayerFitButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnFitCollision" ToolTipService.ToolTip="A box collision fitted to each selected mesh (select them in the Scene layer first), attached to it">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE740;" FontSize="13" /><TextBlock Text="Fit a box to the selected meshes" /></StackPanel>
                                        </Button>
                                        <Grid x:Name="LayerAddOccluder" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Button HorizontalAlignment="Stretch" Click="OnAddOccluder" Tag="Box"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF158;" FontSize="13" /><TextBlock Text="Box occluder" /></StackPanel></Button>
                                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnAddOccluder" Tag="Plane"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7B3;" FontSize="13" /><TextBlock Text="Plane occluder" /></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                </local:PanelSection>
                                <local:PanelSection x:Name="LayerColoursSection" Header="Colours" Key="LayerColours">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap" Text="Untick a colour to hide that kind." Margin="0,0,0,4" />
                                        <StackPanel x:Name="LayerLegend" Spacing="0" />
                                    </StackPanel>
                                </local:PanelSection>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Add ===== -->
                    <Grid x:Name="AddPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Categories -->
                        <Grid x:Name="AddCategoryBar" Padding="8,8,8,6" ColumnSpacing="4" RowSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <ToggleButton x:Name="AddPropsButton" Style="{StaticResource TileToggleStyle}" Tag="Props" Click="OnAddCategory" ToolTipService.ToolTip="Props and entities of the game">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xF158;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Props" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddLightsButton" Grid.Column="1" Style="{StaticResource TileToggleStyle}" Tag="Lights" Click="OnAddCategory" ToolTipService.ToolTip="Point, spot and area lights, and presets">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE781;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Lights" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddDoorsButton" Grid.Column="2" Style="{StaticResource TileToggleStyle}" Tag="Door" Click="OnAddCategory" ToolTipService.ToolTip="Working doors and gates">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE8A1;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Doors" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddRoadsButton" Grid.Column="3" Style="{StaticResource TileToggleStyle}" Tag="Roads" Click="OnAddCategory" ToolTipService.ToolTip="Road types: draw and bend roads">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE804;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Roads" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddVfxButton" Grid.Row="1" Style="{StaticResource TileToggleStyle}" Tag="Vfx" Click="OnAddCategory" ToolTipService.ToolTip="Particle systems and effects of the game">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE734;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Effects" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddDecalsButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource TileToggleStyle}" Tag="Decal" Click="OnAddCategory" ToolTipService.ToolTip="Decals: your own pictures, and the game's (graffiti, dirt, signs, puddles…)">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE790;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Decals" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddSoundsButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource TileToggleStyle}" Tag="Sound" Click="OnAddCategory" ToolTipService.ToolTip="Copies of the sound emitters loaded around you">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE767;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Sounds" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddElevatorsButton" Grid.Column="4" Style="{StaticResource TileToggleStyle}" Tag="Elevators" Click="OnAddCategory" ToolTipService.ToolTip="Working elevators: choose a type and a look, place it, then click on each level where it stops">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE8CB;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Elevators" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddPrefabsButton" Grid.Column="5" Style="{StaticResource TileToggleStyle}" Tag="Prefabs" Click="OnAddCategory" ToolTipService.ToolTip="Your prefabs: groups of objects saved to reuse (Edit ▸ Save selection as prefab)">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE7B8;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Prefabs" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddCustomButton" Grid.Row="1" Grid.Column="4" Style="{StaticResource TileToggleStyle}" Tag="Custom" Click="OnAddCategory" ToolTipService.ToolTip="Your custom meshes: models imported from FBX, glTF, GLB, OBJ... (drop files on the window)">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE8B5;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Custom" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddCollisionButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource TileToggleStyle}" Tag="Collision" Click="OnAddCategory" ToolTipService.ToolTip="Collision shapes and occluders">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE81E;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Collision" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="AddMaterialsButton" Grid.Row="1" Grid.Column="5" Style="{StaticResource TileToggleStyle}" Tag="Materials" Click="OnAddCategory" ToolTipService.ToolTip="Materials: your bank (made, imported from the game), the project's, and putting them on meshes">
                                <StackPanel Spacing="3"><FontIcon Glyph="&#xE771;" FontSize="15" /><Viewbox StretchDirection="DownOnly" Height="15" HorizontalAlignment="Center"><TextBlock Text="Materials" FontSize="11" /></Viewbox></StackPanel>
                            </ToggleButton>
                        </Grid>
                        <!-- Search -->
                        <Grid x:Name="AddSearchRow" Grid.Row="1" Padding="8,0,8,6" ColumnSpacing="6" RowSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBox x:Name="AddSearch" PlaceholderText="Search…" TextChanged="OnAddSearch" />
                            <ComboBox x:Name="RoadFamilyFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnRoadFamilyFilter" MinWidth="110" Visibility="Collapsed">
                                <x:String>All types</x:String>
                                <x:String>With sidewalks</x:String>
                                <x:String>No sidewalk</x:String>
                                <x:String>Highway</x:String>
                                <x:String>Dirt road</x:String>
                                <x:String>Rail and metro</x:String>
                                <x:String>Other pieces</x:String>
                                <x:String>Grey shapes (no textures)</x:String>
                            </ComboBox>
                            <ComboBox x:Name="PropCategoryFilter" Grid.Column="1" SelectedIndex="1" SelectionChanged="OnPropCategory" MinWidth="118" Visibility="Collapsed" ToolTipService.ToolTip="Category">
                                <x:String>All categories</x:String>
                                <x:String>Furniture</x:String>
                                <x:String>Decoration</x:String>
                                <x:String>Devices</x:String>
                                <x:String>Vegetation</x:String>
                                <x:String>Architecture</x:String>
                                <x:String>Vehicles</x:String>
                                <x:String>Characters</x:String>
                                <x:String>Weapons and items</x:String>
                                <x:String>Effects</x:String>
                                <x:String>Environment</x:String>
                                <x:String>Quests</x:String>
                                <x:String>Other</x:String>
                            </ComboBox>
                            <Button x:Name="AddLibraryButton" Grid.Column="2" Style="{StaticResource PaneIconButtonStyle}" Width="30" Height="30" Content="&#xE8F1;" Click="OnOpenLibrary"
                                    ToolTipService.ToolTip="Open the full library: big cards, favorites, appearances  (Ctrl+L)" />
                            <Button x:Name="ImportModelButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Height="30" Padding="10,0" Click="OnImportModel" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Import a model into your custom library: FBX, glTF, GLB, OBJ, DAE, 3DS, or a zip holding one (you can also drop files on the window)">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B5;" FontSize="12" /><TextBlock Text="Import…" FontSize="12" /></StackPanel>
                            </Button>
                            <Button x:Name="ImportSoundButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Height="30" Padding="10,0" Click="OnImportSound" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Import sounds into your custom library: MP3, WAV, OGG, FLAC, M4A, WMA (you can also drop files on the window). Played by Open77 only.">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8D6;" FontSize="12" /><TextBlock Text="Import…" FontSize="12" /></StackPanel>
                            </Button>
                            <Button x:Name="ImportDecalButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Height="30" Padding="10,0" Click="OnImportDecal" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Import pictures into your decal bank: PNG, JPG, TGA, BMP, GIF, TIFF, WebP (you can also drop them on the window). Transparency is kept.">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B9;" FontSize="12" /><TextBlock Text="Import…" FontSize="12" /></StackPanel>
                            </Button>
                            <TextBlock x:Name="AddCount" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource HintStyle}" />
                            <!-- Your decals: the bank (MainWindow.Decals.cs), above the game's list -->
                            <StackPanel x:Name="DecalBank" Grid.Row="2" Grid.ColumnSpan="3" Spacing="4" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="DecalBankTitle" Text="Your decals" FontSize="12" FontWeight="SemiBold" />
                                <GridView x:Name="DecalBankGrid" SelectionMode="Single" SelectionChanged="OnDecalCardSelected" DoubleTapped="OnDecalCardDoubleTapped" RightTapped="OnDecalCardRightTapped"
                                          MaxHeight="250" Padding="0,2,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:DecalCard">
                                            <Grid Width="100" Height="116" RowSpacing="2" Padding="5,5,5,3" ToolTipService.ToolTip="{x:Bind Tip}">
                                                <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Border CornerRadius="4" Background="{StaticResource ThumbBackgroundBrush}" Padding="4">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE790;" FontSize="22" Foreground="{StaticResource TextTertiaryBrush}" Visibility="{x:Bind GlyphVisibility}" />
                                                        <Image Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="{x:Bind Detail}" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <TextBlock x:Name="DecalBankEmpty" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                                <TextBlock Text="Game decals" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <!-- Content -->
                        <local:AssetGrid x:Name="AddGrid" Grid.Row="2" />
                        <ListView x:Name="ElementCatalogList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnElementCatalogSelected" RightTapped="OnElementCatalogRightTapped" Visibility="Collapsed" Padding="0,0,0,8">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ElementResourceItem">
                                    <Grid Padding="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="3" Background="{StaticResource TileBackgroundBrush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid x:Name="PrefabPane" Grid.Row="2" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <Button Margin="8,0,8,8" Style="{StaticResource ActionRowStyle}" Click="OnSavePrefab" ToolTipService.ToolTip="Saves the selected objects (meshes, lights, effects, doors, collision) as one reusable group">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Save the selection as a prefab…" /></StackPanel>
                            </Button>
                            <GridView x:Name="PrefabGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnPrefabSelected" DoubleTapped="OnPrefabDoubleTapped" RightTapped="OnPrefabRightTapped" Padding="8,0,4,8">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PrefabCard">
                                        <Grid Width="116" Height="138" RowSpacing="3" ToolTipService.ToolTip="{x:Bind Tip}">
                                            <Grid.RowDefinitions><RowDefinition Height="92" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Border CornerRadius="4" Background="{StaticResource ThumbBackgroundBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE7B8;" FontSize="26" Foreground="{StaticResource TextTertiaryBrush}" Visibility="{x:Bind GlyphVisibility}" />
                                                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="{x:Bind Detail}" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <StackPanel x:Name="PrefabEmpty" Grid.Row="1" Spacing="6" Padding="20,30" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE7B8;" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Text="No prefab yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Select a set of objects (a kitchen corner, a desk, a wall kit), then save it as a prefab to place it again anywhere, in any project." />
                            </StackPanel>
                        </Grid>
                        <!-- Materials: the project's and the bank's (built in MainWindow.MaterialBank.cs) -->
                        <Grid x:Name="MaterialPane" Grid.Row="2" Visibility="Collapsed" />
                        <ScrollViewer x:Name="LightsPane" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="10,0,10,12" Spacing="10">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource TileButtonStyle}" Tag="Point" Click="OnPlaceLight" ToolTipService.ToolTip="Shines in every direction">
                                        <StackPanel Spacing="4"><FontIcon Glyph="&#xE781;" FontSize="20" /><TextBlock Text="Point" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource TileButtonStyle}" Tag="Spot" Click="OnPlaceLight" ToolTipService.ToolTip="A cone along the light's +Y axis (placed pointing down)">
                                        <StackPanel Spacing="4"><FontIcon Glyph="&#xE7F4;" FontSize="20" /><TextBlock Text="Spot" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource TileButtonStyle}" Tag="Area" Click="OnPlaceLight" ToolTipService.ToolTip="A glowing capsule">
                                        <StackPanel Spacing="4"><FontIcon Glyph="&#xE706;" FontSize="20" /><TextBlock Text="Area" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Presets" FontSize="12" FontWeight="SemiBold" Margin="2,6,0,0" />
                                <StackPanel x:Name="LightPresetList" Spacing="4" />
                                <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="2,4,0,0"
                                           Text="Choose a light, then click in the world (Esc stops). Turn on the night preview in World ▸ Display to judge it." />
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="CollisionPane" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="10,0,10,12" Spacing="10">
                                <TextBlock Text="Collision" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,0" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource TileButtonStyle}" Click="OnAddCollision" Tag="Box"><StackPanel Spacing="4"><FontIcon Glyph="&#xF158;" FontSize="20" /><TextBlock Text="Box" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Button>
                                    <Button Grid.Column="1" Style="{StaticResource TileButtonStyle}" Click="OnAddCollision" Tag="Sphere"><StackPanel Spacing="4"><FontIcon Glyph="&#xEA3A;" FontSize="20" /><TextBlock Text="Sphere" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Button>
                                    <Button Grid.Column="2" Style="{StaticResource TileButtonStyle}" Click="OnAddCollision" Tag="Capsule"><StackPanel Spacing="4"><FontIcon Glyph="&#xE91F;" FontSize="20" /><TextBlock Text="Capsule" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Button>
                                </Grid>
                                <Button Style="{StaticResource ActionRowStyle}" Click="OnFitCollision" ToolTipService.ToolTip="A box collision fitted to each selected mesh, attached to it">
                                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE740;" FontSize="14" /><TextBlock Text="Fit a box to the selected meshes" /></StackPanel>
                                </Button>
                                <TextBlock Text="Occluders" FontSize="12" FontWeight="SemiBold" Margin="2,6,0,0" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource TileButtonStyle}" Click="OnAddOccluder" Tag="Box"><StackPanel Spacing="4"><FontIcon Glyph="&#xF158;" FontSize="20" /><TextBlock Text="Box occluder" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Button>
                                    <Button Grid.Column="1" Style="{StaticResource TileButtonStyle}" Click="OnAddOccluder" Tag="Plane"><StackPanel Spacing="4"><FontIcon Glyph="&#xE7B3;" FontSize="20" /><TextBlock Text="Plane occluder" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Button>
                                </Grid>
                                <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                           Text="New shapes go on the surface at the centre of the view. The Collision and Occlusion layers (top bar) select and edit them; their display settings are in the Inspector." />
                                <local:PanelSection Header="Legend" Key="CollisionLegend" Margin="-10,0">
                                    <StackPanel Spacing="10">
                                        <StackPanel x:Name="CollisionLegend" Spacing="3" />
                                        <StackPanel x:Name="OccluderLegend" Spacing="3" />
                                    </StackPanel>
                                </local:PanelSection>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- What is chosen, and how to place it -->
                        <StackPanel Grid.Row="3" Background="{StaticResource PaneHeaderBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid x:Name="ElementArmedBar" ColumnSpacing="8" Padding="12,8,8,8" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ElementArmedText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Stop (Esc)" Click="OnStopPlacing" />
                            </Grid>
                            <StackPanel x:Name="AddSelectionBar" Padding="12,8,12,10" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="AddSelectionName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AddSelectionDetail" Style="{StaticResource HintStyle}" TextWrapping="Wrap" MaxLines="3" />
                                <ComboBox x:Name="AddAppearanceBox" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="OnAddAppearanceChanged" PlaceholderText="Appearance" />
                                <Grid x:Name="AddPlaceButtons" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="AddPlaceButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnAddPlace" ToolTipService.ToolTip="Then click where it goes in the world">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Place" /></StackPanel>
                                    </Button>
                                    <Button x:Name="AddPlaceFrontButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnAddPlaceFront" ToolTipService.ToolTip="On the surface at the centre of the view (double-click a card does the same)">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B5;" FontSize="13" /><TextBlock Text="In front" /></StackPanel>
                                    </Button>
                                </Grid>
                                <Grid x:Name="CustomActions" ColumnSpacing="6" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button Click="OnEditCustomMaterials" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Colours, textures, roughness, metalness, normal map, emission, transparency, glass or a game material">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE790;" FontSize="13" /><TextBlock Text="Materials…" /></StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Click="OnCustomMenu" ToolTipService.ToolTip="Rename, show its folder, delete">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                                    </Button>
                                </Grid>
                                <Grid x:Name="DecalActions" ColumnSpacing="6" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button HorizontalAlignment="Stretch" Click="OnDecalPlaceFront" ToolTipService.ToolTip="On the surface at the centre of the view (or click in the world; double-click its card does the same)">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B5;" FontSize="13" /><TextBlock Text="In front" /></StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnDecalOptions" ToolTipService.ToolTip="Its name, its size when placed, and whether it glows">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="13" /><TextBlock Text="Size and glow…" /></StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Click="OnDecalMenu" ToolTipService.ToolTip="Rename, replace the picture, show its folder, delete">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                                    </Button>
                                </Grid>
                                <Grid x:Name="SoundActions" ColumnSpacing="6" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button HorizontalAlignment="Stretch" Click="OnSoundListen" ToolTipService.ToolTip="Listen (once, at full volume)">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="SoundListenIcon" Glyph="&#xE768;" FontSize="13" /><TextBlock x:Name="SoundListenText" Text="Listen" /></StackPanel>
                                    </Button>
                                    <Button x:Name="SoundPlaceFrontButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnSoundPlaceFront" ToolTipService.ToolTip="On the surface at the centre of the view (or click in the world)">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B5;" FontSize="13" /><TextBlock Text="In front" /></StackPanel>
                                    </Button>
                                    <Button x:Name="SoundMenuButton" Grid.Column="2" Click="OnSoundMenu" ToolTipService.ToolTip="Rename, show its folder, delete">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                                    </Button>
                                </Grid>
                                <Grid x:Name="VfxActions" ColumnSpacing="6" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button HorizontalAlignment="Stretch" Click="OnVfxPreview" ToolTipService.ToolTip="Plays it in front of the camera, without placing it">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="VfxPreviewIcon" Glyph="&#xE768;" FontSize="13" /><TextBlock x:Name="VfxPreviewText" Text="Preview it" /></StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnVfxPlaceFront" ToolTipService.ToolTip="On the surface at the centre of the view (or click in the world)">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B5;" FontSize="13" /><TextBlock Text="In front" /></StackPanel>
                                    </Button>
                                </Grid>
                                <Grid x:Name="RoadActions" ColumnSpacing="6" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="NewRoadButton" Style="{StaticResource AccentButtonStyle}" Click="OnNewRoad" HorizontalAlignment="Stretch" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Draw a road" /></StackPanel>
                                    </Button>
                                    <Button x:Name="ApplyRoadTypeButton" Grid.Column="1" Content="Use for selected road" Click="OnApplyRoadType" HorizontalAlignment="Stretch" IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ===== World ===== -->
                    <ScrollViewer x:Name="WorldPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <local:PanelSection Header="Map" Key="WorldMap">
                                <local:PanelSection.HeaderActions>
                                    <TextBlock Text="click to travel" Style="{StaticResource HintStyle}" />
                                </local:PanelSection.HeaderActions>
                                <Grid x:Name="MapHost" Height="260" Background="#0B0D11" CornerRadius="3">
                                    <Image x:Name="MapImage" Stretch="Uniform" />
                                    <Canvas x:Name="MapOverlay" Background="Transparent" />
                                    <TextBlock x:Name="MapPlaceholder" Text="The map appears once the game is indexed." Style="{StaticResource HintStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </local:PanelSection>
                            <local:PanelSection Header="Go to" Key="WorldGoTo">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid><NumberBox x:Name="GoX" SpinButtonPlacementMode="Hidden" PlaceholderText="X" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisXBrush}" /></Grid>
                                        <Grid Grid.Column="1"><NumberBox x:Name="GoY" SpinButtonPlacementMode="Hidden" PlaceholderText="Y" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisYBrush}" /></Grid>
                                        <Grid Grid.Column="2"><NumberBox x:Name="GoZ" SpinButtonPlacementMode="Hidden" PlaceholderText="Z" /><Rectangle Width="2" HorizontalAlignment="Left" Margin="0,4" Fill="{StaticResource AxisZBrush}" /></Grid>
                                        <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnGoToCoordinates" ToolTipService.ToolTip="Travel" Padding="10,4">
                                            <FontIcon Glyph="&#xE724;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    <Button Content="Use the camera position" Click="OnUseCameraPosition" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </local:PanelSection>
                            <local:PanelSection Header="Bookmarks" Key="WorldBookmarks">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="BookmarkName" PlaceholderText="Name this view" KeyDown="OnBookmarkKey" />
                                        <Button Grid.Column="1" Click="OnAddBookmark" ToolTipService.ToolTip="Bookmark the current view" Padding="10,4"><FontIcon Glyph="&#xE718;" FontSize="13" /></Button>
                                    </Grid>
                                    <ListView x:Name="BookmarkList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnBookmarkClick" MaxHeight="240" Margin="-12,0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:BookmarkItem">
                                                <Grid Padding="4,2" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE707;" FontSize="13" Foreground="#E0B04A" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                                        <TextBlock Text="{x:Bind Coordinates}" Style="{StaticResource HintStyle}" FontFamily="{StaticResource MonoFont}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource PaneIconButtonStyle}" Content="&#xE74D;" Tag="{x:Bind Name}" Click="OnDeleteBookmark" ToolTipService.ToolTip="Remove" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="NoBookmarks" Text="Bookmark the places you edit often." Style="{StaticResource HintStyle}" />
                                </StackPanel>
                            </local:PanelSection>
                            <local:PanelSection Header="Display" Key="WorldDisplay">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Edit layer" Style="{StaticResource PropLabelStyle}" />
                                        <Border Grid.Column="1" BorderBrush="{StaticResource StrongHairlineBrush}" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="ScenePanelLayer" Style="{StaticResource SegmentToggleStyle}" Content="Scene" Tag="Scene" Click="OnLayerClick" />
                                                <ToggleButton x:Name="CollisionPanelLayer" Style="{StaticResource SegmentToggleStyle}" Content="Collision" Tag="Collision" Click="OnLayerClick" />
                                                <ToggleButton x:Name="OcclusionPanelLayer" Style="{StaticResource SegmentToggleStyle}" Content="Occlusion" Tag="Occlusion" Click="OnLayerClick" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                               Text="The layer decides what clicks, Shift+drag rectangles and the gizmo work on. In the Collision and Occlusion layers the Inspector shows what is drawn (range, filters, colours) and how to add shapes." />
                                    <ToggleSwitch x:Name="NightSwitch" Header="Night lighting preview" OffContent="Daylight" OnContent="Night: the lights around you are lit" Toggled="OnNightSwitch" />
                                    <CheckBox x:Name="ShowCollisionBox" Content="Show collision in the Scene layer" Click="OnShowCollisionBox" />
                                    <CheckBox x:Name="ShowOccludersBox" Content="Show occluders in the Scene layer" Click="OnShowOccludersBox" />
                                </StackPanel>
                            </local:PanelSection>
                            <local:PanelSection Header="Streaming" Key="WorldStreaming">
                                <StackPanel Spacing="8">
                                    <ProgressBar x:Name="StreamProgress" Maximum="1" Foreground="{StaticResource CyanBrush}" />
                                    <TextBlock x:Name="StreamDetails" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                    <Expander x:Name="IssuesExpander" Header="Loading issues" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" Expanding="OnIssuesExpanding">
                                        <ScrollViewer MaxHeight="220"><TextBlock x:Name="IssuesText" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11" IsTextSelectionEnabled="True" /></ScrollViewer>
                                    </Expander>
                                    <TextBlock Style="{StaticResource HintStyle}"
                                               Text="Static and instanced meshes with default variants, plus distant proxies (levels 2–6, display only). Foliage, terrain detail and quest state are not reproduced yet." />
                                </StackPanel>
                            </local:PanelSection>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Project ===== -->
                    <ScrollViewer x:Name="ProjectPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Padding="14,14,14,12" Spacing="8" Background="{StaticResource PaneHeaderBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                                <TextBox x:Name="ProjectNameBox" FontSize="16" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="2,2" Margin="-2,0"
                                         KeyDown="OnProjectNameKey" LostFocus="OnProjectNameCommit" ToolTipService.ToolTip="Rename the project" />
                                <TextBlock x:Name="ProjectPathText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProjectChanges" Style="{StaticResource CaptionStyle}" />
                                <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button Click="OnSaveProject" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Save (Ctrl+S)">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="12" /><TextBlock Text="Save" FontSize="12" /></StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Click="OnSaveProjectAs" HorizontalAlignment="Stretch" Content="Save as…" FontSize="12" />
                                    <Button Grid.Column="2" Click="OnOpenProject" HorizontalAlignment="Stretch" Content="Open…" FontSize="12" />
                                    <Button Grid.Column="3" Click="OnNewProject" HorizontalAlignment="Stretch" Content="New" FontSize="12" />
                                </Grid>
                            </StackPanel>
                            <local:PanelSection Header="Recent projects" Key="ProjectRecent">
                                <StackPanel Spacing="2">
                                    <StackPanel x:Name="RecentList" Spacing="2" />
                                    <TextBlock x:Name="RecentEmpty" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Text="Projects you open or save appear here." />
                                </StackPanel>
                            </local:PanelSection>
                            <local:PanelSection Header="Export" Key="ProjectExport">
                                <StackPanel Spacing="6">
                                    <Button Style="{StaticResource ActionRowStyle}" Click="OnExport" ToolTipService.ToolTip="Moved and deleted objects become guarded patches, added objects new sectors; mesh assets stay references to your installation">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEDE1;" FontSize="14" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="ArchiveXL mod…" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionRowStyle}" Click="OnExportOpen77" ToolTipService.ToolTip="An Open77 world resource (open77.lua + dist/*.zip): the server preloads it as a required mod and the launcher installs it before the game starts">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Open77 world resource…" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionRowStyle}" Click="OnExportWorldBuilder" ToolTipService.ToolTip="Added objects only, for the entSpawner WolvenKit import script">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="World Builder JSON…" /></StackPanel>
                                    </Button>
                                    <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button x:Name="InstallButton" Click="OnInstall" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="Copies the last export into the game (close the game first)">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;" FontSize="12" /><TextBlock Text="Install last export" FontSize="12" /></StackPanel>
                                        </Button>
                                        <Button x:Name="OpenExportButton" Grid.Column="1" Click="OnOpenExportFolder" HorizontalAlignment="Stretch" IsEnabled="False">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE838;" FontSize="12" /><TextBlock Text="Open its folder" FontSize="12" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <Button Click="OnRemoveMod" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="12" /><TextBlock Text="Remove an installed NCWE mod…" FontSize="12" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </local:PanelSection>
                            <local:PanelSection Header="Game installation" Key="ProjectGame">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="GamePathText" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                    <TextBlock x:Name="GameIndexText" Style="{StaticResource HintStyle}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Content="Change…" Click="OnBrowseGame" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="Recover autosave…" Click="OnRecover" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </local:PanelSection>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Live collaboration ===== -->
                    <ScrollViewer x:Name="LivePanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Padding="14,14,14,12" Spacing="8" Background="{StaticResource PaneHeaderBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="LiveStateDot" Width="9" Height="9" Fill="#6E727A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LiveTitle" Grid.Column="1" Text="Live collaboration" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock x:Name="LiveSubtitle" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                           Text="Build this world together, live: everyone sees the others' edits, cameras and selections. Sessions run on your Open//77 account." />
                                <StackPanel x:Name="LiveIdle" Spacing="8">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Click="OnStartSession" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Opens this world to others: they join with the session code and its password">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE716;" FontSize="12" /><TextBlock Text="Start a session…" FontSize="12" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Click="OnJoinSession" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FA;" FontSize="12" /><TextBlock Text="Join…" FontSize="12" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Shared worlds stay in your cloud: whoever opens one joins the others working on it, live, or continues from where they stopped." />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Click="OnShareWorld" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72D;" FontSize="12" /><TextBlock Text="Share this world…" FontSize="12" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Click="OnOpenFromCloud" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE753;" FontSize="12" /><TextBlock Text="Shared worlds…" FontSize="12" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <HyperlinkButton Content="I have an invite code" Click="OnJoinSharedWorld" Padding="0,2" FontSize="12" />
                                    <TextBlock x:Name="LiveAccountHint" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Text="Requires an Open//77 account: you will be asked to sign in." />
                                </StackPanel>
                                <StackPanel x:Name="LiveActive" Spacing="8" Visibility="Collapsed">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button x:Name="LiveCodeButton" Click="OnCopyInvitation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                ToolTipService.ToolTip="Copies the invitation (the session code; give the password separately)">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="LiveCodeText" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold" CharacterSpacing="60" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE8C8;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="LiveLeaveButton" Grid.Column="1" Click="OnLeaveSession" Content="Leave" FontSize="12" />
                                    </Grid>
                                    <TextBlock x:Name="LiveRoleText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <local:PanelSection x:Name="LivePeopleSection" Header="People" Key="LivePeople" Visibility="Collapsed">
                                <StackPanel x:Name="LivePeople" Spacing="2" />
                            </local:PanelSection>
                            <local:PanelSection x:Name="LiveChatSection" Header="Chat" Key="LiveChat" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <ScrollViewer x:Name="LiveChatScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="LiveChatList" Spacing="5" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="LiveChatEmpty" Style="{StaticResource HintStyle}" Text="Messages to everyone in the session." />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="LiveChatBox" PlaceholderText="Message" MaxLength="2000" KeyDown="OnLiveChatKey" />
                                        <Button Grid.Column="1" Click="OnLiveChatSend" Style="{StaticResource IconButtonStyle}" Content="&#xE724;" ToolTipService.ToolTip="Send (Enter)" />
                                    </Grid>
                                </StackPanel>
                            </local:PanelSection>
                            <local:PanelSection x:Name="LiveSettingsSection" Header="Session settings" Key="LiveSettings" Visibility="Collapsed">
                                <StackPanel Spacing="10">
                                    <ToggleSwitch x:Name="LiveLockedSwitch" Header="Locked: nobody new can join" OnContent="Locked" OffContent="Open" Toggled="OnLiveLocked" />
                                    <ComboBox x:Name="LiveDefaultRoleBox" Header="New members join as" HorizontalAlignment="Stretch" SelectionChanged="OnLiveDefaultRole">
                                        <ComboBoxItem Content="Editor (can edit)" Tag="editor" />
                                        <ComboBoxItem Content="Viewer (watches and chats)" Tag="viewer" />
                                    </ComboBox>
                                    <NumberBox x:Name="LiveMaxBox" Header="Participants at most" Minimum="2" Maximum="64" SpinButtonPlacementMode="Compact" ValueChanged="OnLiveMaxParticipants" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Content="Change the password…" Click="OnLivePassword" HorizontalAlignment="Stretch" FontSize="12" />
                                        <Button Grid.Column="1" Content="Banned accounts…" Click="OnLiveBans" HorizontalAlignment="Stretch" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </local:PanelSection>
                            <local:PanelSection x:Name="LiveSaveSection" Header="Keep the world" Key="LiveSave" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <Button Style="{StaticResource ActionRowStyle}" Click="OnSaveToCloud" ToolTipService.ToolTip="A version of the world as it is now, in your Open//77 cloud">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{StaticResource AccentBrush}" /><TextBlock x:Name="LiveSaveCloudText" Text="Save to my cloud" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionRowStyle}" Click="OnSaveProjectAs" ToolTipService.ToolTip="A project file on this PC">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Save a copy on this PC…" /></StackPanel>
                                    </Button>
                                    <Button x:Name="LiveCloseButton" Click="OnCloseSession" HorizontalAlignment="Stretch" Margin="0,6,0,0" ToolTipService.ToolTip="Ends the session for everyone (each keeps the world as it is)">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="12" /><TextBlock Text="Close the session for everyone" FontSize="12" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </local:PanelSection>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid Grid.Row="2" Padding="16,0" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <HyperlinkButton x:Name="DismissError" Content="Dismiss" FontSize="12" Padding="4,0" Visibility="Collapsed" Click="OnDismissError" />
            </StackPanel>
            <TextBlock x:Name="CameraText" Grid.Column="1" Style="{StaticResource ValueStyle}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11.5" />
            <TextBlock x:Name="SceneText" Grid.Column="2" Style="{StaticResource ValueStyle}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11.5" />
            <TextBlock x:Name="FpsText" Grid.Column="3" Style="{StaticResource ValueStyle}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11.5" />
        </Grid>

        <!-- ===== Add ▸ Effects: the effect under a resting pointer, played in a card beside its row ===== -->
        <Canvas x:Name="FxHoverLayer" Grid.RowSpan="3" IsHitTestVisible="False">
            <Border x:Name="FxHoverCard" Width="256" Padding="3" Opacity="0" IsHitTestVisible="False" Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource StrongHairlineBrush}" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <Grid Width="248" Height="248" Background="#FF0B0C0F">
                        <SwapChainPanel x:Name="FxHoverPanel" Opacity="0" IsHitTestVisible="False" />
                        <TextBlock x:Name="FxHoverNote" Style="{StaticResource HintStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Padding="7,6,7,5" Spacing="2">
                        <TextBlock x:Name="FxHoverName" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FxHoverInfo" Style="{StaticResource HintStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ===== Home screen: after the splash until closed (Photoshop-style start) ===== -->
        <Grid x:Name="HomeScreen" Grid.Row="1" Grid.RowSpan="2" Background="#E6101113" Visibility="Collapsed" SizeChanged="OnHomeSizeChanged">
            <Border x:Name="HomeCard" Width="940" MinHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource StrongHairlineBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: start something, the Open//77 account, the credits. It scrolls when the window is too low for it
                         (a first start also asks for the game installation there). -->
                    <ScrollViewer x:Name="HomeLeftScroll" Background="#17181B" CornerRadius="6,0,0,6" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" SizeChanged="OnHomeLeftScrollSize">
                    <Grid x:Name="HomeLeft" Padding="26,26,26,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2" Margin="0,0,0,24">
                            <Image Source="ms-appx:///Assets/ncwe-logo.png" Height="40" Stretch="Uniform" HorizontalAlignment="Left" Margin="-3,0,0,4" AutomationProperties.Name="NCWE Studio" />
                            <TextBlock Text="Night City World Editor" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="HomeBuildText" Style="{StaticResource HintStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <Button x:Name="HomeNewButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Click="OnHomeNew">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="New world project" FontWeight="SemiBold" />
                                        <TextBlock Text="Start from the game's Night City" FontSize="11" Opacity=".8" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="HomeOpenButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Click="OnHomeOpen">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE838;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Open project…" FontWeight="SemiBold" />
                                        <TextBlock Text="A .ncwe.json world project on this PC" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="HomeLoadingPanel" Spacing="6" Margin="0,6,0,0" Visibility="Collapsed">
                                <ProgressBar IsIndeterminate="True" />
                                <TextBlock x:Name="HomeLoadingText" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="HomeGamePanel" Spacing="8" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="HomeGameText" Style="{StaticResource CaptionStyle}" Text="Choose your Cyberpunk 2077 installation first. NCWE only reads its archives; your game files are never modified." />
                                <Button Click="OnBrowseGame" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7FC;" FontSize="14" /><TextBlock Text="Choose installation…" /></StackPanel>
                                </Button>
                                <Button x:Name="HomeDetectedButton" Click="OnUseDetectedGame" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                            </StackPanel>
                            <!-- The previous run ended without closing (a crash): where its report is -->
                            <Border x:Name="HomeCrashNotice" Margin="0,6,0,0" Padding="12,10" CornerRadius="4" Background="#1FFF7A7A" BorderBrush="#55FF7A7A" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FF7A7A" />
                                        <TextBlock Text="NCWE closed unexpectedly" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock FontSize="11.5" Foreground="#C9CCD2" TextWrapping="Wrap"
                                               Text="What Windows recorded about it was saved with NCWE&#x2019;s logs. To report it, send last-crash-windows.txt and exceptions.log from that folder." />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton Content="Open the logs folder" Click="OnOpenLogs" FontSize="11.5" Padding="2,1" />
                                        <HyperlinkButton Content="Dismiss" Click="OnCrashNoticeDismiss" FontSize="11.5" Padding="2,1" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Open//77 account: optional for editing, required for cloud saves and live collaboration -->
                        <Grid x:Name="HomeAccountCard" Grid.Row="3" MinHeight="152" Margin="0,14,0,0" CornerRadius="5" BorderThickness="1" BorderBrush="#5522E4F2">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0F1013" Offset="0" />
                                    <GradientStop Color="#FF121A20" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Canvas IsHitTestVisible="False">
                                <Polygon Points="196,0 226,0 160,176 130,176" Fill="#1A22E4F2" />
                                <Polygon Points="240,0 270,0 204,176 174,176" Fill="#1022E4F2" />
                            </Canvas>
                            <Rectangle Height="2" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF22E4F2" Offset="0" />
                                        <GradientStop Color="#0022E4F2" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Padding="16,13,16,13" Spacing="9">
                                <Grid>
                                    <Button Style="{StaticResource TitleBarLinkStyle}" Padding="0" Height="Auto" Click="OnOpen77Site" ToolTipService.ToolTip="NCWE is made by the Open//77 team, the multiplayer platform for Cyberpunk 2077. Opens open2077.net">
                                        <Image Source="ms-appx:///Assets/open77-logo-dark.png" Height="18" Stretch="Uniform" HorizontalAlignment="Left" />
                                    </Button>
                                    <Border x:Name="HomeAccountBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#2622E4F2" CornerRadius="3" Padding="7,2">
                                        <TextBlock x:Name="HomeAccountBadgeText" Text="OPTIONAL" FontSize="9.5" FontWeight="SemiBold" CharacterSpacing="120" Foreground="#22E4F2" />
                                    </Border>
                                </Grid>
                                <!-- Signed out -->
                                <StackPanel x:Name="HomeSignedOut" Spacing="8">
                                    <TextBlock Text="Sign in with your Open//77 account" FontSize="14" FontWeight="SemiBold" Foreground="#F2F4F7" TextWrapping="Wrap" />
                                    <TextBlock Text="Optional for editing. Required to save your worlds in the cloud and to build them together, live." FontSize="11.5" Foreground="#C9CCD2" TextWrapping="Wrap" />
                                    <Button x:Name="HomeSignInButton" Click="OnAccountSignIn" HorizontalAlignment="Stretch" Padding="12,7" Background="#22E4F2" Foreground="#06121A" BorderThickness="0" CornerRadius="4"
                                            ToolTipService.ToolTip="Opens open2077.net in your browser: sign in or create an account there. Your password is never typed into NCWE.">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="#06121A" />
                                            <TextBlock Text="Sign in with Open//77" FontWeight="SemiBold" Foreground="#06121A" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- Waiting for the browser -->
                                <StackPanel x:Name="HomeSigningIn" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="Finish signing in in your browser" FontSize="14" FontWeight="SemiBold" Foreground="#F2F4F7" />
                                    <TextBlock Text="open2077.net is open in your browser: sign in or create your account there, then come back here." FontSize="11.5" Foreground="#C9CCD2" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ProgressRing IsActive="True" Width="16" Height="16" Foreground="#22E4F2" />
                                        <TextBlock Grid.Column="1" Text="Waiting for open2077.net…" FontSize="11.5" Foreground="#9FB0C2" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Cancel" Click="OnAccountCancel" FontSize="12" Padding="10,3" />
                                    </Grid>
                                </StackPanel>
                                <!-- Signed in -->
                                <StackPanel x:Name="HomeSignedIn" Spacing="9" Visibility="Collapsed">
                                    <Grid ColumnSpacing="11">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#22E4F2">
                                            <TextBlock x:Name="HomeAccountInitial" FontSize="17" FontWeight="SemiBold" Foreground="#06121A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="HomeAccountName" FontSize="14" FontWeight="SemiBold" Foreground="#F2F4F7" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HomeAccountDetail" FontSize="11.5" Foreground="#9FB0C2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Cloud saves and live collaboration are on: File ▸ Save to the cloud, and Collaborate in the title bar." FontSize="11.5" Foreground="#C9CCD2" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <HyperlinkButton Content="Manage account" Click="OnAccountManage" FontSize="11.5" Padding="2,1" />
                                        <TextBlock Text="·" Foreground="#6E727A" VerticalAlignment="Center" />
                                        <HyperlinkButton Content="Sign out" Click="OnAccountSignOut" FontSize="11.5" Padding="2,1" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="HomeAccountError" FontSize="11.5" Foreground="#FF7A7A" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- WolvenKit (the toolkit NCWE reads and writes the game's files with) and ArchiveXL (what
                             loads the worlds it exports): NCWE would not exist without them. -->
                        <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="Powered by" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,2,0" />
                                <HyperlinkButton x:Name="HomeWolvenKit" Click="OnWolvenKitSite" Padding="2,2" ToolTipService.ToolTip="github.com/WolvenKit/WolvenKit">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="WolvenKit" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <FontIcon Glyph="&#xE8A7;" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HyperlinkButton>
                                <TextBlock Text="and" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,2,0" />
                                <HyperlinkButton x:Name="HomeArchiveXl" Click="OnArchiveXlSite" Padding="2,2" ToolTipService.ToolTip="github.com/psiberx/cp2077-archive-xl">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="ArchiveXL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <FontIcon Glyph="&#xE8A7;" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>
                            <TextBlock Text="Without them, NCWE would not have been possible. Thank you to their authors." FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="2,0,0,0" />
                            <HyperlinkButton Click="OnCredits" Padding="2,2" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEB51;" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Credits and licenses" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>

                    <!-- Right: recent projects -->
                    <Grid Grid.Column="1" Padding="28,22,18,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2" Margin="0,4,48,0">
                            <TextBlock Text="Recent projects" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="HomeRecentCaption" Style="{StaticResource HintStyle}" Text="Pick up where you left off." />
                        </StackPanel>
                        <Button x:Name="HomeCloseButton" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Content="&#xE711;" Click="OnHomeClose"
                                HorizontalAlignment="Right" VerticalAlignment="Top" ToolTipService.ToolTip="Close  (Esc)" />
                        <ScrollViewer Grid.Row="1" Padding="0,0,10,0">
                            <StackPanel x:Name="HomeRecentList" Spacing="4" />
                        </ScrollViewer>
                        <StackPanel x:Name="HomeRecentEmpty" Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE81C;" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="No recent projects yet" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintStyle}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="300"
                                       Text="Create a world project or open one: the projects you open and save are listed here." />
                        </StackPanel>
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="HomeAtStartupBox" Content="Show this screen at startup" FontSize="12" MinWidth="0" Click="OnHomeAtStartup" />
                            <!-- The interface language (Help ▸ Language) -->
                            <DropDownButton x:Name="HomeLanguageButton" Grid.Column="2" FontSize="12" Padding="8,3" ToolTipService.ToolTip="Interface language">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE774;" FontSize="12" />
                                    <TextBlock x:Name="HomeLanguageText" FontSize="12" />
                                </StackPanel>
                                <DropDownButton.Flyout><MenuFlyout x:Name="HomeLanguageMenu" Placement="TopEdgeAlignedRight" /></DropDownButton.Flyout>
                            </DropDownButton>
                            <TextBlock Grid.Column="1" Style="{StaticResource HintStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="File ▸ Home screen brings it back" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
