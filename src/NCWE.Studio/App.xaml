<Application
    x:Class="NCWE.Studio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tool look: square corners, flat neutral surfaces, one restrained accent. -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

            <Color x:Key="SystemAccentColor">#3D7DCA</Color>
            <Color x:Key="SystemAccentColorLight1">#4A8AD6</Color>
            <Color x:Key="SystemAccentColorLight2">#5A97DE</Color>
            <Color x:Key="SystemAccentColorLight3">#74A9E6</Color>
            <Color x:Key="SystemAccentColorDark1">#3470B8</Color>
            <Color x:Key="SystemAccentColorDark2">#2B5F9E</Color>
            <Color x:Key="SystemAccentColorDark3">#224C80</Color>

            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#1B1C1F" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#232428" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232428" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#2C2E33" />
            <SolidColorBrush x:Key="FloatingSurfaceBrush" Color="#F2232428" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#34363C" />
            <SolidColorBrush x:Key="StrongHairlineBrush" Color="#45484F" />
            <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#2A2C31" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DADCE0" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9DA4" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E727A" />
            <SolidColorBrush x:Key="AccentBrush" Color="#3D7DCA" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#333D7DCA" />
            <SolidColorBrush x:Key="CyanBrush" Color="#3D7DCA" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E06C6C" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#2EE06C6C" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#7FB069" />

            <FontFamily x:Key="IconFont">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas</FontFamily>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <!-- A titled section of a docked panel: separated by a hairline, no card. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,0,0,12" />
            </Style>
            <Style x:Key="FloatingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource FloatingSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="BarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="BarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="TitleBarLinkStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="10,6" />
            </Style>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <!-- ===== Sidebar ===== -->
            <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#0C1016" />
            <SolidColorBrush x:Key="PaneHeaderBrush" Color="#1F2024" />
            <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#1A1B1E" />
            <SolidColorBrush x:Key="TileBackgroundBrush" Color="#2A2C31" />
            <SolidColorBrush x:Key="TileHoverBrush" Color="#33363C" />
            <SolidColorBrush x:Key="AxisXBrush" Color="#D9534F" />
            <SolidColorBrush x:Key="AxisYBrush" Color="#6DBA4E" />
            <SolidColorBrush x:Key="AxisZBrush" Color="#4F8FE0" />
            <!-- Compact text fields everywhere (NumberBox, TextBox, AutoSuggestBox). -->
            <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
            <Thickness x:Key="TextControlThemePadding">8,4,6,4</Thickness>

            <!-- Pane titles: OUTLINER, and the like. -->
            <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Left labels of property rows ("Position", "Intensity"...). -->
            <Style x:Key="PropLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            </Style>

            <!-- Big square-ish tiles: an icon over a label (place a light, a collision shape...). -->
            <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="58" />
                <Setter Property="Padding" Value="4,8" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="{StaticResource TileBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="TileToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="2,6" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="{StaticResource TileBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Segmented choices (Project | World, Scene | Collision | Occlusion). -->
            <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Height" Value="26" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Small square icon buttons of pane headers. -->
            <Style x:Key="PaneIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <!-- Full-width action rows (Export…, Install…). -->
            <Style x:Key="ActionRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Background" Value="{StaticResource TileBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
