<!-- AI agents (MCP): the bridge, connecting AI clients, the agents' activity and diagnostics. -->
<Window
    x:Class="NCWE.Studio.McpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NCWE.Studio"
    Title="AI agents (MCP) — NCWE Studio">

    <Grid x:Name="Root" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="NavButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,9" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="18,16" />
            </Style>
            <Style x:Key="MonoStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{StaticResource HeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE99A;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="AI agents" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="the NCWE MCP server: let Claude, Codex and other agents build in Studio" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>
            <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Grid Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0" Padding="10,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <ToggleButton x:Name="NavOverview" Style="{StaticResource NavButtonStyle}" Tag="Overview" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE80F;" FontSize="15" /><TextBlock Text="Overview" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavConnect" Style="{StaticResource NavButtonStyle}" Tag="Connect" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE71B;" FontSize="15" /><TextBlock Text="Connect an AI" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavActivity" Style="{StaticResource NavButtonStyle}" Tag="Activity" Click="OnNav">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="Activity" />
                            <TextBlock x:Name="NavActivityCount" Grid.Column="2" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="NavDiagnostics" Style="{StaticResource NavButtonStyle}" Tag="Diagnostics" Click="OnNav">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE9F9;" FontSize="15" /><TextBlock Text="Diagnostics" /></StackPanel>
                    </ToggleButton>
                </StackPanel>
                <!-- The bridge at a glance, on every page -->
                <Border Grid.Row="2" Background="{StaticResource TileBackgroundBrush}" CornerRadius="5" Padding="12,10">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="NavDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource TextTertiaryBrush}" />
                            <TextBlock x:Name="NavState" Text="Bridge off" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="NavPipe" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Overview ===== -->
            <ScrollViewer x:Name="OverviewPage" Grid.Column="1" Padding="28,22,28,24">
                <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="An AI client (Claude Code, Codex, Claude Desktop…) starts the NCWE MCP server, which drives this Studio through its AI bridge: placing props, lights, collision, roads, taking screenshots. You watch it work here and can undo every step." />
                    </StackPanel>

                    <!-- The bridge -->
                    <Border x:Name="BridgePanel" Style="{StaticResource PanelStyle}" Padding="20,18">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid Width="48" Height="48">
                                <Ellipse x:Name="BridgeHalo" Fill="{StaticResource TileBackgroundBrush}" />
                                <FontIcon x:Name="BridgeIcon" Glyph="&#xE71B;" FontSize="22" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="BridgeTitle" Text="AI bridge" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="BridgeDetail" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="BridgeToggle" MinWidth="120" Click="OnBridgeToggle" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Numbers -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="COMMANDS" Style="{StaticResource PaneTitleStyle}" />
                                <TextBlock x:Name="StatRequests" Text="0" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatErrors" Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="LAST ACTION" Style="{StaticResource PaneTitleStyle}" />
                                <TextBlock x:Name="StatLast" Text="—" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatLastDetail" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="AGENTS SEEN" Style="{StaticResource PaneTitleStyle}" />
                                <TextBlock x:Name="StatAgents" Text="None yet" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatAgentsDetail" Style="{StaticResource HintStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- The server program -->
                    <Border Style="{StaticResource PanelStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="NCWE MCP server" FontSize="15" FontWeight="SemiBold" />
                                    <Border x:Name="ServerChip" CornerRadius="9" Padding="8,1" VerticalAlignment="Center"><TextBlock x:Name="ServerChipText" FontSize="11" FontWeight="SemiBold" /></Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="The program your AI clients start. It lives at a fixed path, so registrations survive Studio updates." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button x:Name="ServerUpdateButton" Style="{StaticResource AccentButtonStyle}" Content="Install / update" Click="OnServerUpdate" />
                                <Button Click="OnServerShow" ToolTipService.ToolTip="Show in Explorer"><FontIcon Glyph="&#xE838;" FontSize="14" /></Button>
                                <Button Click="OnServerCopy" ToolTipService.ToolTip="Copy the path"><FontIcon Glyph="&#xE8C8;" FontSize="14" /></Button>
                            </StackPanel>
                            <TextBlock x:Name="ServerPath" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource MonoStyle}" />
                        </Grid>
                    </Border>

                    <!-- Clients at a glance -->
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="AI clients on this PC" FontSize="15" FontWeight="SemiBold" />
                                <HyperlinkButton Content="Connect an AI ›" HorizontalAlignment="Right" Padding="4,0" Tag="Connect" Click="OnNavLink" />
                            </Grid>
                            <StackPanel x:Name="ClientSummary" Orientation="Horizontal" Spacing="8" />
                        </StackPanel>
                    </Border>

                    <!-- How it works -->
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Getting started" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" /></Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Text="Connect your AI client once (Connect an AI): Studio writes its configuration for you." />
                                <Border Grid.Row="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Text="Restart the client. It starts the NCWE MCP server itself; nothing else to launch." />
                                <Border Grid.Row="2" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Text="Keep this Studio open with the AI bridge on, and ask: “Build a small apartment in front of the camera, with lights and collision.”" />
                                <Border Grid.Row="3" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Text="Follow it in Activity. Something wrong? Diagnostics runs a real round trip and tells what to fix." />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Connect an AI ===== -->
            <ScrollViewer x:Name="ConnectPage" Grid.Column="1" Padding="28,22,28,24" Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="1000">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Connect an AI" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Register the NCWE MCP server with the AI clients you use. Studio edits their configuration (keeping a .ncwe-backup copy) or runs their own command; restart the client afterwards." />
                    </StackPanel>
                    <StackPanel x:Name="ClientList" Spacing="10" />
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Another MCP client" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Any client that speaks MCP over stdio works: give it this program as the command (no arguments), or paste the JSON block into its MCP settings." />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource FieldBackgroundBrush}" CornerRadius="4" Padding="10,8"><TextBlock x:Name="GenericCommand" Style="{StaticResource MonoStyle}" /></Border>
                                <Button Grid.Column="1" Content="Copy" VerticalAlignment="Top" Click="OnCopyGenericCommand" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource FieldBackgroundBrush}" CornerRadius="4" Padding="10,8"><TextBlock x:Name="GenericJson" Style="{StaticResource MonoStyle}" /></Border>
                                <Button Grid.Column="1" Content="Copy" VerticalAlignment="Top" Click="OnCopyGenericJson" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintStyle}" Text="Options: --headless runs a hidden Studio of its own for the session; --attach-only never starts Studio; --game &lt;folder&gt; picks the game. NCWE.Mcp.exe --help lists them all." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Activity ===== -->
            <Grid x:Name="ActivityPage" Grid.Column="1" Padding="28,22,28,16" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Activity" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Every command an agent (or a script) sent to this Studio, newest first. Edits are regular undo steps: Ctrl+Z in Studio reverts them." />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="HidePollsBox" Content="Hide status checks" IsChecked="True" MinWidth="0" Click="OnActivityFilter" />
                    <CheckBox x:Name="ErrorsOnlyBox" Grid.Column="1" Content="Errors only" MinWidth="0" Click="OnActivityFilter" />
                    <TextBlock x:Name="ActivitySummary" Grid.Column="2" Style="{StaticResource HintStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                    <Button Grid.Column="3" Click="OnActivityCopy"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="Copy" /></StackPanel></Button>
                    <Button Grid.Column="4" Click="OnActivityClear"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Clear" /></StackPanel></Button>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Padding="14,8" ColumnSpacing="12" Background="{StaticResource PaneHeaderBrush}" CornerRadius="6,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                            <TextBlock Text="TIME" Style="{StaticResource PaneTitleStyle}" />
                            <TextBlock Grid.Column="1" Text="AGENT" Style="{StaticResource PaneTitleStyle}" />
                            <TextBlock Grid.Column="2" Text="COMMAND" Style="{StaticResource PaneTitleStyle}" />
                            <TextBlock Grid.Column="3" Text="TIME TAKEN" Style="{StaticResource PaneTitleStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" Padding="0,2,0,6">
                            <StackPanel x:Name="ActivityList" />
                        </ScrollViewer>
                        <StackPanel x:Name="ActivityEmpty" Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="No activity yet" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintStyle}" HorizontalAlignment="Center" Text="Ask your AI client to do something in NCWE: its commands appear here." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Diagnostics ===== -->
            <ScrollViewer x:Name="DiagnosticsPage" Grid.Column="1" Padding="28,22,28,24" Visibility="Collapsed">
                <StackPanel Spacing="16" MaxWidth="1000">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Checks the whole chain: the bridge, the server program, a real round trip (the server started like an AI client would and asked for Studio's status), the clients' registrations and the server log." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button x:Name="RunChecksButton" Style="{StaticResource AccentButtonStyle}" Click="OnRunChecks">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Run diagnostics" /></StackPanel>
                            </Button>
                            <Button Click="OnCopyReport" ToolTipService.ToolTip="Copy a report (checks, versions, recent log) to share"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="Copy report" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource PanelStyle}" Padding="6,6">
                        <StackPanel>
                            <StackPanel x:Name="CheckList" />
                            <StackPanel x:Name="ChecksRunning" Orientation="Horizontal" Spacing="10" Padding="12,10" Visibility="Collapsed">
                                <ProgressRing IsActive="True" Width="16" Height="16" />
                                <TextBlock Text="Running the checks (starting the server, a round trip through the pipe)…" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ChecksHint" Style="{StaticResource HintStyle}" Margin="12,10" Text="Run diagnostics to check every link of the chain." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Running MCP servers" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="Each AI client session starts its own. Stopping one cuts that agent off until its client starts it again." />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefreshServers"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Refresh" /></StackPanel></Button>
                            </Grid>
                            <StackPanel x:Name="ServerList" Spacing="6" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Server log" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LogPathText" Style="{StaticResource HintStyle}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                                    <Button Click="OnRefreshLog"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Refresh" /></StackPanel></Button>
                                    <Button Click="OnOpenLog" ToolTipService.ToolTip="Open in Notepad"><FontIcon Glyph="&#xE8E5;" FontSize="14" /></Button>
                                    <Button Click="OnOpenLogFolder" ToolTipService.ToolTip="Show the folder"><FontIcon Glyph="&#xE838;" FontSize="14" /></Button>
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource FieldBackgroundBrush}" CornerRadius="4" Padding="10,8" MaxHeight="320">
                                <ScrollViewer x:Name="LogScroller" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="LogText" Style="{StaticResource MonoStyle}" TextWrapping="NoWrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status line -->
        <Grid Grid.Row="2" Padding="14,0" Background="{StaticResource HeaderBackgroundBrush}">
            <TextBlock x:Name="StatusLine" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
